    "checklist.confirm.discard.message" : {
      "comment" : "Alert message before discarding a brand-new checklist from its create sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد تجاهل قائمة التحقق هذه؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই চেকলিস্টটি ফেলে দেবেন? এটি আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols descartar aquesta llista de comprovació? No es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahodit tento kontrolní seznam? Tuto akci nelze vrátit zpět."
