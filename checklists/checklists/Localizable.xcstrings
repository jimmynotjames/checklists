        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆதார் (உள்நாட்டு விமானம்), பாஸ்போர்ட் (வெளிநாடு), ஓட்டுநர் உரிமம் (சாலைப் பயணம்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విమాన ప్రయాణానికి ఆధార్, విదేశాలకైతే పాస్‌పోర్ట్, రోడ్డు ప్రయాణానికి డ్రైవింగ్ లైసెన్స్."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัตรประชาชนถ้าบินในประเทศ พาสปอร์ตถ้าไปต่างประเทศ ใบขับขี่ถ้าขับรถไปเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
