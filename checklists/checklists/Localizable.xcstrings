        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ ਤੇ iCloud ਨੂੰ Screen Time ਜਾਂ ਤੁਹਾਡੀ ਸੰਸਥਾ ਦੁਆਰਾ ਬੰਦ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ। ਤੁਹਾਡੀਆਂ ਚੈਕਲਿਸਟਾਂ ਸਿਰਫ ਇਸ ਡਿਵਾਈਸ ਤੇ ਸੁਰੱਖਿਅਤ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa iCloud jest wyłączona na tym urządzeniu przez Czas przed ekranem lub Twoją organizację. Twoje listy kontrolne są zapisywane tylko na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
