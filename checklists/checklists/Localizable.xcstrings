    "consent.action.accept.hint" : {
      "comment" : "VoiceOver hint for the accept button on the analytics consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفعّل مشاركة بيانات الاستخدام المجهولة لمساعدة التطبيق على التحسّن. لا يتم تضمين أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ উন্নত করতে বেনামি ব্যবহারের ডেটা চালু করুন। কখনও অন্তর্ভুক্ত নয়: চেকলিস্ট আইটেম নাম, আইটেম নোট বা Apple বা iCloud সনাক্তকারী।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa les dades d'ús anònimes per ajudar a millorar l'aplicació. Les dades mai inclouen noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne odesílání anonymních dat o používání, která pomohou zlepšit aplikaci. Jména položek kontrolního seznamu, poznámky k položkám ani identifikátory Apple či iCloud nejsou nikdy zahrnuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer anonyme brugsdata for at hjælpe med at forbedre appen. Navn på tjekliste-elementer, element-noter eller Apple- eller iCloud-identifikatorer medtages aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert anonyme Nutzungsdaten zur Verbesserung der App. Checklisten-Einträge, Notizen oder Apple- oder iCloud-Kennungen sind niemals enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί τα ανώνυμα δεδομένα χρήσης για βελτίωση της εφαρμογής. Δεν περιλαμβάνονται ποτέ ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el envío de datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el envío de datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottaa käyttöön anonyymit käyttötiedot sovelluksen parantamiseksi. Tarkistuslistan kohdan nimiä, kohdan muistiinpanoja tai Apple- tai iCloud-tunnuksia ei koskaan sisällytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les données d'utilisation anonymes pour aider à améliorer l'app. Les noms des éléments de liste, les notes d'éléments et les identifiants Apple ou iCloud ne sont jamais inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les données d'utilisation anonymes pour aider à améliorer l'application. Les noms des éléments de la liste de vérification, les notes des éléments ou les identifiants Apple ou iCloud ne sont jamais inclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અનામી ઉપયોગ ડેટા ચાલુ કરે છે જે એપ્લીકેશનને સુધારવામાં મદદ કરે છે. ચેકલિસ્ટ આઇટમ નામો, આઇટમ નોંધો અથવા Apple અથવા iCloud ઓળખકર્તાઓ ક્યારેય સમાવવામાં આવતી નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל נתוני שימוש אנונימיים כדי לעזור לשפר את האפליקציה. שמות של פריטים ברשימת תיוג, הערות או מזהים של Apple או iCloud לא כלולים אף פעם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को बेहतर बनाने के लिए अनाम उपयोग डेटा चालू करता है। चेकलिस्ट आइटम के नाम, आइटम नोट्स, या Apple या iCloud पहचानकर्ता कभी शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućava aplikaciji slanje anonimnih podataka o upotrebi kako bi se poboljšala aplikacija. Nikad nisu uključeni nazivi stavki kontrolnog popisa, bilješke stavki ili Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsolja az anonim használati adatokat az alkalmazás javítása érdekében. Az ellenőrzőlista elemek nevei, elemjegyzetek vagy Apple- vagy iCloud-azonosítók soha nem szerepelnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan pengiriman data penggunaan anonim untuk membantu meningkatkan aplikasi. Nama item daftar periksa, catatan item, atau identifikasi Apple atau iCloud tidak pernah disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la condivisione dei dati di utilizzo anonimi per aiutare a migliorare l'app. Non vengono mai inclusi i nomi degli elementi, le note o gli identificatori di Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの改善に役立つ匿名の使用状況データを有効にします。チェックリスト項目の名前、項目のメモ、AppleまたはiCloudの識別子は含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅ್ಯಾಪ್ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಲು ಅನಾಮಧೇಯ ಬಳಕೆ ಡೇಟಾ ಚಾಲು ಮಾಡುತ್ತದೆ. ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಐಟಂ ಟಿಪ್ಪಣಿಗಳು ಅಥವಾ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳು ಎಂದಿಗೂ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 사용 데이터를 켜서 앱 개선을 돕습니다. 체크리스트 항목 이름, 항목 메모 또는 Apple이나 iCloud 식별자는 절대 포함되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അപ്ലിക്കേഷൻ മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്ന അജ്ഞാത ഉപയോഗ ഡാറ്റ സജ്ജമാക്കുക. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകൾ, ഇനങ്ങളുടെ കുറിപ്പുകൾ, അല്ലെങ്കിൽ Apple അല്ലെങ്കിൽ iCloud ഐഡന്റിഫയറുകൾ ഒരിക്കലും അടങ്ങിയിരിക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अ्‍ॅप सुधारण्यास मदत करण्यासाठी अनामिक वापर डेटा चालू करतो। चेकलिस्ट आयटम नावे, आयटम टिपा किंवा Apple किंवा iCloud ओळखकर्ता कधीही समाविष्ट केले जात नाहीत।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghidupkan data penggunaan tanpa nama untuk membantu meningkatkan aplikasi. Nama item senarai semak, nota item, atau pengecam Apple atau iCloud tidak pernah disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår på anonyme bruksdata for å hjelpe til med å forbedre appen. Sjekkliste-elementnavn, notater eller Apple- eller iCloud-identifikatorer er aldri inkludert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt anonieme gebruiksgegevens in om de app te verbeteren. Checklistnamen, itemnotities of Apple- of iCloud-identifiers worden nooit opgenomen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅ୍ୟାପ୍‍କୁ ଉନ୍ନତ କରିବାରେ ସାହାଯ୍ୟ କରିବାକୁ ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ତଥ୍ୟ ଚାଲୁ କରେ। ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ଟିପ୍ପଣୀ, କିମ୍ବା Apple କିମ୍ବା iCloud ଚିହ୍ନାକାରୀ କଦାଚ ଅନ୍ତର୍ଭୁକ୍ତ ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਚਾਲੂ ਕਰਦਾ ਹੈ। ਕਦੇ ਵੀ ਚੈੱਕਲਿਸਟ ਆਈਟਮ ਦੇ ਨਾਂ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ Apple ਜਾਂ iCloud ਪਛਾਣਕਾਰ ਸ਼ਾਮਿਲ ਨਹੀਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza anonimowe dane o użytkowaniu, aby pomóc ulepszyć aplikację. Nazwy elementów listy, notatki do elementów oraz identyfikatory Apple i iCloud nigdy nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa dados de uso anônimos para ajudar a melhorar o app. Nomes de itens do checklist, notas de itens ou identificadores Apple ou iCloud nunca são incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa dados de utilização anónimos para ajudar a melhorar a aplicação. Os nomes de itens da lista de verificação, as notas dos itens, nem nenhuns identificadores Apple ou iCloud são nunca incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează trimiterea de date anonime de utilizare pentru a ajuta la îmbunătățirea aplicației. Numele articolelor din listă, notițele articolelor, sau identificatorii Apple sau iCloud nu sunt niciodată incluși."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает отправку анонимных данных об использовании для улучшения приложения. Названия пунктов чек-листа, заметки пунктов и идентификаторы Apple или iCloud никогда не включаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne odosielanie anonymných údajov o používaní na zlepšenie aplikácie. Nikdy sa nezbierajú: názvy položiek kontrolného zoznamu, poznámky k položkám alebo identifikátory Apple a iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vključi anonimne podatke o uporabi, da bi izboljšali aplikacijo. Imena postavk, opombe postavk ali kakršni koli Apple ali iCloud identifikatorji se nikoli ne vključijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverar anonym användningsdata för att förbättra appen. Checklistors namn, objektanteckningar eller Apple- eller iCloud-identifierare lagras aldrig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயன்பாட்டை மேம்படுத்த உதவ அநாமதேய பயன்பாட்டுத் தரவைக் கொண்டுவருகிறது. சரிபார்ப்புப் பட்டியல் உருப்படி பெயர்கள், உருப்படி குறிப்புகள், அல்லது Apple அல்லது iCloud அடையாளங்கள் ஒருபோதும் சேர்க்கப்படுவதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనువర్తనాన్ని మెరుగుపరచడానికి సహాయపడటానికి అనామక వినియోగ డేటాను ఆన్ చేస్తుంది. చెక్‌లిస్ట్ అంశం పేర్లు, అంశం గమనికలు, లేదా Apple లేదా iCloud గుర్తింపులు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุงแอป ไม่มีการรวมชื่อรายการเช็คลิสต์ หมายเหตุรายการ หรือตัวระบุ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı iyileştirmeye yardımcı olmak için anonim kullanım verilerini açar. Kontrol listesi öğe adları, öğe notları veya Apple ya da iCloud tanımlayıcıları hiçbir zaman dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть надсилання анонімних даних про використання, щоб допомогти вдосконалити додаток. Назви пунктів чек-листу, нотатки до пунктів та ідентифікатори Apple та iCloud ніколи не включаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو بہتر بنانے میں مدد کے لیے گمنام استعمال کا ڈیٹا چالو کرتا ہے۔ چیک لسٹ آئٹم کے نام، آئٹم نوٹس، یا Apple یا iCloud شناخت کی معلومات کبھی شامل نہیں ہوتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Tên mục danh sách kiểm tra, ghi chú mục, hoặc mã định danh Apple hay iCloud không bao giờ được bao gồm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用匿名使用数据以帮助改进应用。永远不包含清单项目名称、项目备注或 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟匿名使用資料，協助改進應用程式。絕不包含檢查清單項目名稱、項目備註或任何 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
