    "containerFailure.confirm.message" : {
      "comment" : "Message of the confirmation alert before deleting local data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبدأ التطبيق كما لو كان مثبتًا حديثًا. ستفقد أي بيانات على هذا الجهاز. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি নতুন ইনস্টল করার মতো শুরু হবে। এই ডিভাইসের সব ডেটা হারিয়ে যাবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això inicia l'app com si l'acabessis d'instal·lar. Es perdran totes les dades d'aquest dispositiu. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se spustí jako při nové instalaci. Všechna data v tomto zařízení budou ztracena. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen starter, som var den nyinstalleret. Alle data på denne enhed går tabt. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird gestartet, als wäre sie neu installiert. Alle Daten auf diesem Gerät gehen verloren. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή θα ξεκινήσει σαν να έχει μόλις εγκατασταθεί. Όλα τα δεδομένα σε αυτή τη συσκευή θα χαθούν. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si acabaras de instalarla. Se perderán los datos de este dispositivo. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si estuviera recién instalada. Se perderán los datos de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus käynnistyy kuin se olisi juuri asennettu. Kaikki tämän laitteen tiedot menetetään. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app repartira comme si elle venait d'être installée. Toutes les données de cet appareil seront perdues. Cette action est irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app démarrera comme si elle venait d'être installée. Toutes les données de cet appareil seront perdues. Cette action est irréversible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ એપ્લિકેશનને નવી ઇન્સ્ટૉલ કર્યા જેવી શરૂ કરે છે. આ ડિવાઇસ પરનો બધો ડેટા ગુમાવાશે. આ પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה תופעל כאילו הותקנה זה עתה. כל הנתונים במכשיר זה יאבדו. אי אפשר לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे ऐप ऐसे शुरू होगा जैसे वह अभी इंस्टॉल हुआ हो। इस डिवाइस का सारा डेटा खो जाएगा। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija će se pokrenuti kao da je tek instalirana. Svi podaci na ovom uređaju bit će izgubljeni. Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy indítja el az appot, mintha újonnan telepítette volna. Az eszközön lévő összes adat elvész. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi akan dimulai seperti baru dipasang. Semua data di perangkat ini akan hilang. Tindakan ini tidak dapat dibatalkan."
