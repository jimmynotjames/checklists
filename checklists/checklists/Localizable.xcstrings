    "settings.icloud.footer.paused" : {
      "comment" : "Footer under the iCloud section when sync is paused for this launch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوائم التحقق محفوظة على هذا الجهاز فقط. أعد تشغيل التطبيق لإعادة محاولة مزامنة iCloud."
          }
        },
