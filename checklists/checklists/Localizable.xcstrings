    "consent.action.decline.hint" : {
      "comment" : "VoiceOver hint for the decline button on the analytics consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إبقاء مشاركة بيانات الاستخدام المجهولة معطّلة. يمكن تغيير هذا لاحقًا في الإعدادات."
