          "stringUnit" : {
            "state" : "translated",
            "value" : "Free up iCloud storage in Settings to resume syncing. Your checklists are saved on this device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free up iCloud storage in Settings to resume syncing. Your checklists are saved on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio en iCloud en Ajustes para reanudar la sincronización. Tus listas se guardan en este dispositivo."
          }
        },
        "es-MX" : {
