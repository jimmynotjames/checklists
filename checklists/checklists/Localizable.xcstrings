        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תפעיל את האפליקציה מחדש כאילו הותקנה זה עתה. כל הנתונים במכשיר זה יימחקו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप को ऐसे शुरू करता है जैसे वह अभी इंस्टॉल हुआ हो। इस डिवाइस का सारा डेटा मिट जाएगा। इसे वापस नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo pokreće aplikaciju kao da je tek instalirana. Svi podaci na ovom uređaju bit će izgubljeni. Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez úgy indítja az alkalmazást, mintha újonnan telepítve lenne. Az eszközön lévő összes adat elvész. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memulai aplikasi seolah-olah baru saja diinstal. Data apa pun di perangkat ini akan hilang. Ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app ripartirà come se fosse appena installata. I dati su questo dispositivo andranno persi. L'operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを新規インストール時のように起動します。このデバイスのデータが失われます。これは元に戻せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಆ್ಯಪ್ ಅನ್ನು ಹೊಸದಾಗಿ ಸ್ಥಾಪಿಸಿದಂತೆ ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ಈ ಸಾಧನದಲ್ಲಿನ ಎಲ್ಲಾ ಡೇಟಾ ಕಳೆದುಹೋಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 새로 설치된 것처럼 시작됩니다. 이 기기의 모든 데이터가 손실됩니다. 되돌릴 수 없습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് ആപ്പ് പുതുതായി ഇൻസ്റ്റാൾ ചെയ്തതു പോലെ ആരംഭിക്കും. ഈ ഉപകരണത്തിലെ എല്ലാ ഡാറ്റയും നഷ്ടപ്പെടും. ഇത് പഴയപടിയാക്കാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे अ‍ॅप नव्याने इन्स्टॉल केल्यासारखे सुरू होईल. या डिव्हाइसवरील सर्व डेटा नष्ट होईल. ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memulakan aplikasi seolah-olah ia baru dipasang. Sebarang data pada peranti ini akan hilang. Ini tidak boleh dibatalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nylig installert. Alle data på denne enheten vil gå tapt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit start de app alsof deze net is geïnstalleerd. Alle gegevens op dit apparaat gaan verloren. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଆପ୍‌କୁ ନୂଆ ଇନଷ୍ଟଲ ହୋଇଥିବା ପରି ଆରମ୍ଭ କରିବ। ଏହି ଡିଭାଇସରେ ଥିବା ସମସ୍ତ ତଥ୍ୟ ନଷ୍ଟ ହୋଇଯିବ। ଏହା ପୁନଃ ପରିବର୍ତ୍ତନ ହୋଇପାରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਐਪ ਨੂੰ ਇਸ ਤਰ੍ਹਾਂ ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ ਜਿਵੇਂ ਇਹ ਹੁਣੇ ਇੰਸਟਾਲ ਹੋਈ ਹੋਵੇ। ਇਸ ਡਿਵਾਈਸ ਦਾ ਸਾਰਾ ਡਾਟਾ ਮਿਟ ਜਾਵੇਗਾ। ਇਹ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To uruchamia aplikację, jakby była zainstalowana po raz pierwszy. Wszystkie dane na tym urządzeniu zostaną utracone. Nie będzie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso inicia o app como se fosse recém-instalado. Qualquer dado neste dispositivo será perdido. Esta ação não pode ser desfeita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto inicia a aplicação como se tivesse sido recém-instalada. Quaisquer dados neste dispositivo serão perdidos. Isto não pode ser desfeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația va porni ca și cum ar fi nou instalată. Toate datele de pe acest dispozitiv se vor pierde. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это запустит приложение как после новой установки. Все данные на этом устройстве будут удалены. Это действие невозможно отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
