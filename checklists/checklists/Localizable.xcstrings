    "settings.analytics.footer" : {
      "comment" : "Footer under the analytics section explaining what usage data is and is not collected.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد بيانات الاستخدام المجهولة على حل المشاكل وفهم الاستخدام. لا يتم ربط البيانات بحسابك في Apple أبدًا. لا يتم تضمين: أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو أي معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেনামি ব্যবহারের ডেটা সমস্যা সমাধান ও ব্যবহারের ধরন বুঝতে সাহায্য করে। ডেটা কখনও আপনার Apple অ্যাকাউন্টের সাথে যুক্ত করা হয় না। কখনও অন্তর্ভুক্ত নয়: চেকলিস্ট আইটেমের নাম, আইটেম নোট, বা যেকোনো Apple বা iCloud পরিচয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades d'ús anònimes ajuden a solucionar problemes i entendre l'ús. Les dades mai no es vinculen al teu compte d'Apple. Mai no s'inclouen: noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymní data o používání pomáhají řešit problémy a pochopit, jak se aplikace používá. Data nejsou nikdy propojena s vaším Účtem Apple. Nikdy nejsou zahrnuty: názvy položek kontrolních seznamů, poznámky k položkám ani žádné identifikátory Apple nebo iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme brugsdata hjælper med at løse problemer og forstå brugen. Data bliver aldrig knyttet til din Apple-konto. Aldrig inkluderet: navne på tjeklistepunkter, noter til punkter eller Apple- eller iCloud-id'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsdaten helfen bei der Fehlersuche und zeigen, wie die App genutzt wird. Die Daten werden nie mit deinem Apple-Account verknüpft. Nie enthalten: Namen von Checklisten-Einträgen, Notizen oder Apple- und iCloud-Kennungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ανώνυμα δεδομένα χρήσης βοηθούν στην αντιμετώπιση προβλημάτων και στην κατανόηση της χρήσης. Τα δεδομένα δεν συνδέονται ποτέ με τον Λογαριασμό Apple σας. Δεν περιλαμβάνονται ποτέ: ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή οποιαδήποτε αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de uso anónimos ayudan a solucionar problemas y a entender el uso. Los datos nunca se vinculan a tu Cuenta de Apple. Nunca se incluyen: nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de uso anónimos ayudan a resolver problemas y entender cómo se usa la app. Los datos nunca se vinculan con tu Cuenta de Apple. Nunca se incluyen: nombres de elementos de la lista, notas de elementos, ni ningún identificador de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyymit käyttötiedot auttavat selvittämään ongelmia ja ymmärtämään käyttöä. Tietoja ei koskaan yhdistetä Apple-tiliisi. Mukana ei koskaan ole: tarkistuslistan kohtien nimiä, kohtien muistiinpanoja tai Applen tai iCloudin tunnisteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d'utilisation anonymes aident à résoudre les problèmes et à comprendre l'usage. Elles ne sont jamais associées à votre Compte Apple. Ne sont jamais inclus : les noms d'éléments, les notes d'éléments, ni aucun identifiant Apple ou iCloud."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d'utilisation anonymes aident à résoudre les problèmes et à comprendre l'utilisation. Les données ne sont jamais liées à votre Compte Apple. Ne sont jamais inclus : les noms d'éléments de liste de vérification, les notes d'éléments ni les identifiants Apple ou iCloud."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અનામી ઉપયોગ ડેટા સમસ્યાઓ ઉકેલવામાં અને ઉપયોગ સમજવામાં મદદ કરે છે. ડેટા ક્યારેય તમારા Apple Account સાથે જોડાયેલો હોતો નથી. ક્યારેય સમાવેશ થતો નથી: ચેકલિસ્ટ આઇટમનાં નામ, આઇટમ નોંધ અથવા કોઈપણ Apple કે iCloud ઓળખકર્તા."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני שימוש אנונימיים עוזרים לפתור בעיות ולהבין שימוש. נתונים לא מקושרים לחשבון Apple שלך. לא כלולים: שמות של פריטים ברשימת תיוג, הערות או מזהים של Apple או iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनाम उपयोग डेटा समस्याओं को हल करने और उपयोग को समझने में मदद करता है। डेटा कभी आपके Apple खाते से जुड़ा नहीं होता। कभी शामिल नहीं: चेकलिस्ट आइटम के नाम, आइटम नोट्स, या कोई Apple या iCloud पहचानकर्ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimni podaci o upotrebi pomažu u rješavanju problema i razumijevanju upotrebe. Podaci se nikada ne povezuju s vašim Apple računom. Nikada nisu uključeni: nazivi stavki kontrolnog popisa, bilješke stavki ni Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az anonim használati adatok segítenek a hibák elhárításában és a használat megértésében. Az adatok soha nem kapcsolódnak Apple-fiókjához. Soha nem tartalmazzák az ellenőrzőlista-elemek nevét, az elemek jegyzeteit, sem semmilyen Apple- vagy iCloud-azonosítót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data penggunaan anonim membantu mengatasi masalah dan memahami penggunaan. Data tidak pernah dikaitkan dengan Akun Apple Anda. Tidak pernah disertakan: nama item daftar periksa, catatan item, atau pengenal Akun Apple maupun iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di utilizzo anonimi aiutano a risolvere i problemi e a comprendere l'utilizzo. I dati non sono mai collegati al tuo Account Apple. Non vengono mai inclusi: i nomi degli elementi dell'elenco, le note o gli identificatori di Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名の使用状況データは、不具合の調査や利用状況の把握に役立ちます。データがAppleアカウントに結び付けられることはありません。チェックリストの項目名やメモ、AppleやiCloudの識別情報が含まれることもありません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅನಾಮಧೇಯ ಬಳಕೆ ಡೇಟಾ ಸಮಸ್ಯೆ ಪರಿಹಾರ ಮತ್ತು ಬಳಕೆ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಡೇಟಾವನ್ನು ನಿಮ್ಮ Apple ಖಾತೆಗೆ ಎಂದಿಗೂ ಜೋಡಿಸಲಾಗುವುದಿಲ್ಲ. ಎಂದಿಗೂ ಸೇರಿಸದಿರುವುದು: ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಟಿಪ್ಪಣಿಗಳು, ಅಥವಾ ಯಾವುದೇ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 사용 데이터는 문제 해결과 사용 현황 파악에 도움이 돼요. 데이터는 Apple 계정과 연결되지 않아요. 체크리스트 항목 이름, 항목 메모, Apple 또는 iCloud 식별자는 포함되지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അജ്ഞാത ഉപയോഗ ഡാറ്റ പ്രശ്നങ്ങൾ പരിഹരിക്കാനും ഉപയോഗം മനസ്സിലാക്കാനും സഹായിക്കുന്നു. ഡാറ്റ ഒരിക്കലും നിങ്ങളുടെ Apple അക്കൗണ്ടുമായി ബന്ധിപ്പിക്കില്ല. ഒരിക്കലും ഉൾപ്പെടുത്താത്തവ: ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകൾ, കുറിപ്പുകൾ, അല്ലെങ്കിൽ ഏതെങ്കിലും Apple അല്ലെങ്കിൽ iCloud ഐഡന്റിഫയറുകൾ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनामिक वापर डेटा समस्या सोडवण्यासाठी आणि वापर समजून घेण्यासाठी मदत करतो. डेटा कधीही तुमच्या Apple खात्याशी जोडला जात नाही. कधीही समाविष्ट नाही: चेकलिस्ट आयटमची नावे, आयटम टिपा किंवा कोणतेही Apple किंवा iCloud आयडेंटिफायर्स."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data penggunaan tanpa nama membantu menyelesaikan masalah dan memahami penggunaan. Data tidak pernah dipautkan ke Akaun Apple anda. Tidak pernah disertakan: nama item senarai semak, nota item, atau pengecam Apple atau iCloud."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme bruksdata hjelper med feilsøking og å forstå bruken. Data kobles aldri til Apple-kontoen din. Aldri inkludert: navn på sjekklistepunkter, notater eller Apple- eller iCloud-identifikatorer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonieme gebruiksgegevens helpen bij het opsporen van problemen en het begrijpen van het gebruik. Gegevens worden nooit gekoppeld aan je Apple Account. Nooit inbegrepen: namen van checklistitems, itemnotities of Apple- of iCloud-identifiers."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ତଥ୍ୟ ସମସ୍ୟା ସମାଧାନ ଏବଂ ବ୍ୟବହାର ବୁଝିବାରେ ସାହାଯ୍ୟ କରେ। ତଥ୍ୟ କେବେ ଆପଣଙ୍କ Apple ଆକାଉଣ୍ଟ ସହିତ ଲିଙ୍କ ହୁଏନାହିଁ। କେବେ ଅନ୍ତର୍ଭୁକ୍ତ ନୁହେଁ: ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ଟିପ୍ପଣୀ, କିମ୍ବା କୌଣସି Apple ବା iCloud ଆଇଡେଣ୍ଟିଫାୟର୍।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਸਮੱਸਿਆਵਾਂ ਹੱਲ ਕਰਨ ਅਤੇ ਵਰਤੋਂ ਸਮਝਣ ਵਿੱਚ ਮਦਦ ਕਰਦਾ ਹੈ। ਡਾਟਾ ਕਦੇ ਵੀ ਤੁਹਾਡੇ Apple ਖਾਤੇ ਨਾਲ ਨਹੀਂ ਜੋੜਿਆ ਜਾਂਦਾ। ਇਸ ਵਿੱਚ ਕਦੇ ਸ਼ਾਮਲ ਨਹੀਂ: ਚੈੱਕਲਿਸਟ ਆਈਟਮ ਦੇ ਨਾਂ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ ਕੋਈ Apple ਜਾਂ iCloud ਪਛਾਣਕਰਤਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimowe dane o użytkowaniu pomagają rozwiązywać problemy i lepiej rozumieć sposób korzystania z aplikacji. Dane nigdy nie są powiązane z Twoim kontem Apple. Nigdy nie obejmują: nazw pozycji listy, notatek ani żadnych identyfikatorów Apple czy iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de uso anônimos ajudam a resolver problemas e entender o uso. Os dados nunca são vinculados à sua Conta Apple. Nunca incluídos: nomes de itens do checklist, notas de itens ou qualquer identificador Apple ou iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de utilização anónimos ajudam a resolver problemas e a compreender a utilização. Os dados nunca são associados à sua Conta Apple. Nunca são incluídos: nomes de itens de listas de verificação, notas de itens ou quaisquer identificadores da Apple ou do iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele anonime de utilizare ajută la depanarea problemelor și la înțelegerea modului de utilizare. Acestea nu sunt niciodată asociate cu Contul Apple. Nu sunt incluse niciodată: numele elementelor din listele de verificare, notițele elementelor sau identificatori Apple sau iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимные данные об использовании помогают устранять неполадки и понимать, как используется приложение. Данные никогда не привязываются к вашему Аккаунту Apple. Никогда не передаются: названия пунктов чек-листа, заметки к пунктам и любые идентификаторы Apple или iCloud."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymné údaje o používaní pomáhajú riešiť problémy a pochopiť používanie. Údaje nie sú nikdy prepojené s vaším Apple Account. Nikdy nie sú zahrnuté: názvy položiek kontrolného zoznamu, poznámky k položkám ani žiadne identifikátory Apple alebo iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimni podatki o uporabi pomagajo odpravljati težave in razumeti uporabo. Podatki nikoli niso povezani z vašim računom Apple. Nikoli ni vključenih: imen postavk kontrolnega seznama, opomb postavk ali kakršnih koli identifikatorjev Apple ali iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonym användningsdata hjälper till att felsöka problem och förstå användningen. Data kopplas aldrig till ditt Apple-konto. Ingår aldrig: namn på checklistpunkter, anteckningar eller Apple- eller iCloud-identifierare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அநாமதேய பயன்பாட்டுத் தரவு சிக்கல்களைச் சரிசெய்யவும் பயன்பாட்டைப் புரிந்துகொள்ளவும் உதவும். தரவு உங்கள் Apple கணக்குடன் ஒருபோதும் இணைக்கப்படாது. சேர்க்கப்படாதவை: சரிபார்ப்புப் பட்டியல் உருப்படிப் பெயர்கள், உருப்படிக் குறிப்புகள், அல்லது ஏதேனும் Apple அல்லது iCloud அடையாளங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనామక వినియోగ డేటా సమస్యలను పరిష్కరించడానికి, వినియోగాన్ని అర్థం చేసుకోవడానికి సహాయపడుతుంది. డేటా మీ Apple ఖాతాతో ఎప్పుడూ లింక్ చేయబడదు. ఎప్పుడూ చేర్చనివి: చెక్‌లిస్ట్ అంశాల పేర్లు, అంశాల గమనికలు, లేదా ఏ Apple లేదా iCloud గుర్తింపులు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลการใช้งานแบบไม่ระบุตัวตนช่วยในการแก้ไขปัญหาและทำความเข้าใจการใช้งาน ข้อมูลจะไม่เชื่อมโยงกับบัญชี Apple ของคุณ ไม่เคยรวม: ชื่อรายการในเช็คลิสต์ หมายเหตุของรายการ หรือตัวระบุใดๆ ของ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonim kullanım verileri, sorunları gidermeye ve kullanımı anlamaya yardımcı olur. Veriler asla Apple Hesabınızla ilişkilendirilmez. Asla dahil edilmeyenler: kontrol listesi öğe adları, öğe notları veya Apple ya da iCloud kimlikleri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонімні дані про використання допомагають усувати несправності та розуміти використання. Дані ніколи не пов'язуються з вашим обліковим записом Apple. Ніколи не передаються: назви пунктів чек-листа, нотатки до пунктів чи будь-які ідентифікатори Apple або iCloud."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گمنام استعمال کا ڈیٹا مسائل کو حل کرنے اور استعمال کو سمجھنے میں مدد کرتا ہے۔ ڈیٹا کبھی آپ کے Apple اکاؤنٹ سے جڑا نہیں ہوتا۔ کبھی شامل نہیں: چیک لسٹ آئٹم کے نام، آئٹم نوٹس، یا کوئی Apple یا iCloud شناخت۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu sử dụng ẩn danh giúp khắc phục sự cố và hiểu rõ mức sử dụng. Dữ liệu không bao giờ được liên kết với Tài khoản Apple của bạn. Không bao gồm: tên mục danh sách kiểm tra, ghi chú mục, hoặc mã định danh Apple hay iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名使用数据有助于排查问题、了解使用情况。数据从不与你的 Apple 账户关联。从不包含：清单项目名称、项目备注，以及任何 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名使用資料協助排除問題和瞭解使用方式。資料絕不會連結到你的 Apple 帳號。絕不包含：檢查清單項目名稱、項目備註或任何 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
