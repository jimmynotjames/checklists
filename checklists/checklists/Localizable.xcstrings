          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii sovelluksen lähettää anonyymejä käyttötietoja, jotka auttavat kehittämään sovellusta. Mukana ei koskaan ole tarkistuslistan kohtien nimiä, kohtien muistiinpanoja tai Applen tai iCloudin tunnisteita."
