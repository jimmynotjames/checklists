    "toast.saveFailed" : {
      "comment" : "Error toast shown when a change could not be written to the device. Full storage is the likely cause but not a certain one — a damaged database fails the same way — so the second sentence must stay a guess (\"may\"), never a statement of fact. Appears briefly at the bottom of the screen with no button. Keep it short; it can appear after any edit (adding, ticking, renaming, deleting).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الحفظ. قد تكون مساحة التخزين في جهازك منخفضة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষণ ব্যর্থ। ডিভাইসের স্টোরেজ কম হতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut guardar. El dispositiu podria no tenir prou espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložení se nezdařilo. Ve vašem zařízení možná dochází úložiště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gemme. Din enhed mangler muligvis plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern fehlgeschlagen. Dein Gerät könnte wenig Speicherplatz haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποθήκευση απέτυχε. Ίσως η συσκευή σας να μην έχει αρκετό χώρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar. Puede que tu dispositivo tenga poco espacio."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar. Tal vez tu dispositivo tenga poco espacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus epäonnistui. Laitteen tallennustila voi olla vähissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'enregistrement. Votre appareil manque peut-être d'espace de stockage."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'enregistrement. Votre appareil manque peut-être d'espace de stockage."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેવ નિષ્ફળ. તમારા ઉપકરણમાં જગ્યા ઓછી હોઈ શકે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמירה נכשלה. ייתכן שאין מקום בהתקן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा नहीं जा सका। डिवाइस का भंडारण कम हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremanje nije uspjelo. Prostor za pohranu na uređaju možda je gotovo pun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentés sikertelen. Lehet, hogy kevés a szabad tárhely az eszközén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menyimpan. Penyimpanan perangkat Anda mungkin hampir penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare. Potrebbe mancare spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存に失敗しました。端末の空き容量が不足している可能性があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಳಿಸಲು ಆಗಲಿಲ್ಲ. ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಕಡಿಮೆ ಇರಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 못했어요. 기기 저장 공간이 부족할 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സേവ് ചെയ്യാനായില്ല. നിങ്ങളുടെ ഉപകരണത്തിൽ സ്റ്റോറേജ് കുറവായിരിക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव्ह झाले नाही। स्टोरेज कमी असू शकते।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal simpan. Ruang peranti anda mungkin penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lagre. Enheten kan være tom for lagringsplass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opslaan mislukt. Je apparaat is mogelijk vol."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଭ ବିଫଲ ହେଲା। ଆପଣଙ୍କ ଡିଭାଇସ ଷ୍ଟୋରେଜ କମ ଥାଇ ପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੰਭਾਲ ਅਸਫਲ। ਡਿਵਾਈਸ ਸਟੋਰੇਜ ਘੱਟ ਹੋ ਸਕਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać. Na urządzeniu może brakować miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao salvar. Seu dispositivo pode estar sem espaço."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao guardar. O seu dispositivo pode estar com pouco armazenamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvarea a eșuat. Dispozitivul poate avea spațiu de stocare redus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить. Возможно, на устройстве недостаточно места."
          }
