    "sample.weekendGetaway.item2.notes" : {
      "comment" : "Note under the Wallet/ID packing item. Adapt to the documents people there carry for flights, border crossings, and driving.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهوية للسفر الداخلي، وجواز السفر للسفر الخارجي، ورخصة القيادة لرحلة السيارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উড়োজাহাজে পরিচয়পত্র, বিদেশে পাসপোর্ট, গাড়ি চালালে লাইসেন্স।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNI per volar, passaport si surts de la UE i carnet de conduir si vas amb cotxe."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občanka do EU, pas mimo Schengen, řidičák na cestu autem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas til flyrejsen, kørekort til bilturen og det gule sundhedskort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalausweis in der EU, Reisepass für Fernreisen, Führerschein fürs Auto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταυτότητα για πτήσεις και Σένγκεν, διαβατήριο εκτός ΕΕ, δίπλωμα για οδήγηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proper ID (ID for air travel, international, driver license for roadtrip, etc.)"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo ID for domestic flights, passport overseas, licence for the drive."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proper ID (photo ID for flights, passport for the border, driver's licence for a road trip)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passport for flights and going abroad, driving licence for a road trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNI para volar por Europa, pasaporte fuera y carnet de conducir si vas en coche."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INE para vuelos nacionales, pasaporte al extranjero, licencia si vas a manejar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilökortti tai passi (passi EU:n ulkopuolelle), ajokortti automatkalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte d'identité pour l'Europe, passeport hors UE, permis pour la route."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeport pour l'avion ou les États-Unis, permis de conduire sur la route, carte d'assurance maladie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હવાઈ મુસાફરી માટે આધાર કાર્ડ, વિદેશ માટે પાસપોર્ટ, રોડ ટ્રિપ માટે ડ્રાઇવિંગ લાઇસન્સ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תעודת זהות לטיסות בארץ, דרכון לחו״ל, רישיון נהיגה לנסיעה ברכב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हवाई यात्रा के लिए आधार, विदेश के लिए पासपोर्ट, रोड ट्रिप के लिए ड्राइविंग लाइसेंस।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobna iskaznica za EU, putovnica izvan EU, vozačka za put autom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Személyi vagy útlevél (EU-n kívülre útlevél), autóhoz jogosítvány és forgalmi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KTP untuk penerbangan domestik, paspor ke luar negeri, SIM kalau nyetir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carta d'identità per volare in UE, passaporto fuori UE, patente per l'auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国内線は身分証、海外はパスポート、車の旅なら運転免許証を忘れずに。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಧಾರ್ (ದೇಶೀಯ ವಿಮಾನಕ್ಕೆ), ಪಾಸ್‌ಪೋರ್ಟ್ (ವಿದೇಶಕ್ಕೆ), ರಸ್ತೆ ಪ್ರಯಾಣಕ್ಕೆ ಡ್ರೈವಿಂಗ್ ಲೈಸೆನ್ಸ್."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국내선은 신분증, 해외는 여권, 운전할 거면 운전면허증까지 챙겨요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആധാർ, ഡ്രൈവിങ് ലൈസൻസ്, വിദേശയാത്രയ്ക്ക് പാസ്പോർട്ട്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विमान प्रवासासाठी आधार कार्ड, गाडी चालवणार असाल तर ड्रायव्हिंग लायसन्स."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyKad untuk penerbangan domestik, pasport ke luar negara, lesen memandu untuk pemanduan jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass til utenlandsreise, førerkort på biltur, bankkort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldig ID: ID-kaart of paspoort voor het buitenland, rijbewijs voor de auto."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଧାର କାର୍ଡ, ବିମାନ ଯାତ୍ରା ପାଇଁ ଫଟୋ ପରିଚୟପତ୍ର, ବିଦେଶ ଗଲେ ପାସପୋର୍ଟ, ଗାଡ଼ି ଚଳାଇଲେ ଡ୍ରାଇଭିଂ ଲାଇସେନ୍ସ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਵਾਈ ਸਫ਼ਰ ਲਈ ਆਧਾਰ ਕਾਰਡ, ਵਿਦੇਸ਼ ਲਈ ਪਾਸਪੋਰਟ, ਗੱਡੀ ਲਈ ਡਰਾਈਵਿੰਗ ਲਾਇਸੈਂਸ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowód osobisty w UE, paszport poza UE, prawo jazdy na wyjazd autem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documento com foto (RG ou CNH na estrada, passaporte para viagem internacional)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartão de Cidadão (passaporte fora da UE, carta de condução se fores de carro)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acte valabile (buletin în UE, pașaport în afara ei, permis dacă mergi cu mașina)."
          }
        },
        "ru" : {
          "stringUnit" : {
