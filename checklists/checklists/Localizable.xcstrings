        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app verrà avviata come se fosse appena installata. Tutti i dati su questo dispositivo andranno persi. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを新規インストールした状態で開始します。このデバイス上のデータはすべて失われます。この操作は取り消せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ್ಯಪ್ ಈಗಷ್ಟೇ ಇನ್‌ಸ್ಟಾಲ್ ಆದಂತೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಈ ಸಾಧನದಲ್ಲಿರುವ ಎಲ್ಲಾ ಡೇಟಾ ಕಳೆದುಹೋಗುತ್ತದೆ. ಇದನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 새로 설치한 것처럼 시작해요. 이 기기의 모든 데이터가 사라지며 취소할 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആപ്പ് പുതുതായി ഇൻസ്റ്റാൾ ചെയ്തതുപോലെ ആരംഭിക്കും. ഈ ഉപകരണത്തിലെ ഡാറ്റ നഷ്ടമാകും. ഇത് പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे अॅप नुकतेच इंस्टॉल केल्यासारखे सुरू होईल. या डिव्हाइसवरील सर्व डेटा नष्ट होईल. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memulakan app seolah-olah baru dipasang. Sebarang data pada peranti ini akan hilang. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nyinstallert. Alle data på denne enheten går tapt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee start de app alsof die net is geïnstalleerd. Alle gegevens op dit apparaat gaan verloren. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଆପ୍‌କୁ ନୂଆ ଇନଷ୍ଟଲ୍ ହୋଇଥିବା ପରି ଆରମ୍ଭ କରିବ। ଏହି ଡିଭାଇସରେ ଥିବା ସମସ୍ତ ଡାଟା ହଜିଯିବ। ଏହାକୁ ଫେରାଇ ଆଣିହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਐਪ ਨੂੰ ਇਸ ਤਰ੍ਹਾਂ ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ ਜਿਵੇਂ ਇਹ ਨਵੀਂ ਇੰਸਟਾਲ ਹੋਈ ਹੋਵੇ। ਇਸ ਡੀਵਾਈਸ ਦਾ ਸਾਰਾ ਡਾਟਾ ਖਤਮ ਹੋ ਜਾਵੇਗਾ। ਇਹ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja zostanie uruchomiona jak po świeżej instalacji. Wszystkie dane na tym urządzeniu zostaną utracone. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso inicia o app como se tivesse acabado de ser instalado. Todos os dados deste dispositivo serão perdidos. Isso não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A app será iniciada como se tivesse acabado de ser instalada. Todos os dados neste dispositivo serão perdidos. Esta ação não pode ser revertida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația va porni ca și cum ar fi nou instalată. Toate datele de pe acest dispozitiv se vor pierde. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение запустится как после новой установки. Все данные на этом устройстве будут потеряны. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia sa spustí, akoby bola práve nainštalovaná. Všetky údaje v tomto zariadení sa stratia. Túto akciu nie je možné vrátiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija se bo zagnala, kot da bi bila na novo nameščena. Vsi podatki v tej napravi bodo izgubljeni. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen startas som om den vore nyinstallerad. All data på den här enheten går förlorad. Det går inte att ångra."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது ஆப்ஸை புதிதாக நிறுவியதுபோல் தொடங்கும். இந்தச் சாதனத்தில் உள்ள தரவு அனைத்தும் இழக்கப்படும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది యాప్‌ను కొత్తగా ఇన్‌స్టాల్ చేసినట్లు ప్రారంభిస్తుంది. ఈ పరికరంలోని డేటా అంతా పోతుంది. దీన్ని తిరిగి మార్చలేరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปจะเริ่มต้นใหม่เหมือนเพิ่งติดตั้ง ข้อมูลทั้งหมดในอุปกรณ์นี้จะหายไป การกระทำนี้เลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama yeni yüklenmiş gibi başlatılır. Bu aygıttaki tüm veriler kaybolur. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок запуститься так, ніби його щойно встановлено. Усі дані на цьому пристрої буде втрачено. Цю дію не можна скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ ایسے شروع ہوگی جیسے ابھی نئی انسٹال ہوئی ہو۔ اس ڈیوائس کا تمام ڈیٹا ختم ہو جائے گا۔ یہ عمل واپس نہیں ہو سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này khởi động ứng dụng như thể mới cài đặt. Mọi dữ liệu trên thiết bị này sẽ bị mất. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会让 App 像刚安装时一样启动。此设备上的所有数据都将丢失，且无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會讓 App 如同剛安裝般重新開始。這部裝置上的所有資料都會遺失，且無法還原。"
          }
        }
      }
