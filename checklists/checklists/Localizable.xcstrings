    "consent.action.decline.hint" : {
      "comment" : "VoiceOver hint for the decline button on the analytics consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي بيانات الاستخدام المجهولة الهوية متوقفة. يمكنك تغيير ذلك لاحقًا من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেনামী ব্যবহারের ডেটা বন্ধ রাখে। পরে সেটিংসে এটি বদলানো যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manté desactivades les dades d'ús anònimes. Ho pots canviar més endavant a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
