    "settings.icloud.footer.paused" : {
      "comment" : "Footer under the iCloud section when sync is paused for this launch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ قوائم التحقق الخاصة بك على هذا الجهاز فقط. أعد تشغيل التطبيق لإعادة محاولة مزامنة iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চেকলিস্ট শুধু এই ডিভাইসে সংরক্ষিত আছে। iCloud সিঙ্ক আবার চেষ্টা করতে অ্যাপটি রিস্টার্ট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves llistes de comprovació només es desen en aquest dispositiu. Reinicia l'app per tornar a provar la sincronització de l'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše kontrolní seznamy jsou uložené jen v tomto zařízení. Restartováním aplikace zkusíte synchronizaci s iCloudem znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine tjeklister gemmes kun på denne enhed. Genstart appen for at prøve iCloud-synkronisering igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Checklisten werden nur auf diesem Gerät gespeichert. Starte die App neu, um die iCloud-Synchronisierung erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λίστες ελέγχου σας είναι αποθηκευμένες μόνο σε αυτή τη συσκευή. Επανεκκινήστε την εφαρμογή για να δοκιμάσετε ξανά τον συγχρονισμό iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas de comprobación se guardan solo en este dispositivo. Reinicia la app para reintentar la sincronización de iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas se guardan solo en este dispositivo. Reinicia la app para reintentar la sincronización con iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistuslistasi tallennetaan vain tähän laitteeseen. Käynnistä sovellus uudelleen kokeillaksesi iCloud-synkronointia."
          }
        },
        "fr" : {
