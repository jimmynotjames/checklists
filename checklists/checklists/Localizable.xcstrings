          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi a iCloud nelle Impostazioni per sincronizzare i tuoi elenchi su più dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」でiCloudにサインインすると、チェックリストをすべてのデバイス間で同期できます。"
