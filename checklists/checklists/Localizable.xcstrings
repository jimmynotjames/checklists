    "containerFailure.message" : {
      "comment" : "Body of the database-failure screen; suggests a restart and checking free storage.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ ما. جرّب إعادة تشغيل التطبيق، وتأكد أن مساحة التخزين غير ممتلئة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু একটা সমস্যা হয়েছে। অ্যাপটি রিস্টার্ট করে দেখবেন? স্টোরেজ পূর্ণ কিনা দেখে নেবেন?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha produït un error. Prova de reiniciar l'aplicació o comprova si l'emmagatzematge és ple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco se nepovedlo. Zkusili jste restartovat aplikaci? Případně zkontrolujte, jestli nemáte plné úložiště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gik noget galt. Prøv at genstarte appen. Tjek også, om lagerpladsen er fuld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas ist schiefgelaufen. Starte die App neu und prüfe, ob dein Speicher voll ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι πήγε στραβά. Δοκιμάστε επανεκκίνηση της εφαρμογής και ελέγξτε αν ο χώρος αποθήκευσης έχει γεμίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try restarting the app? Also check if your storage is full?"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try restarting the app, and check your storage isn't full."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try restarting the app? Also check if your storage is full?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try restarting the app? Also check if your storage is full?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo ha ido mal. Prueba a reiniciar la app. Comprueba también si tienes espacio de almacenamiento disponible."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal. ¿Puedes reiniciar la app? También revisa si tu almacenamiento está lleno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokin meni pieleen. Kokeile käynnistää sovellus uudelleen. Tarkista myös, onko tallennustila täynnä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu. Essayez de redémarrer l'application, et vérifiez si votre espace de stockage est plein."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur est survenue. Essayez de redémarrer l'application. Vérifiez aussi si votre espace de stockage est plein."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કંઈક ખોટું થયું. એપ ફરી શરૂ કરવાનો પ્રયાસ કરશો? એ પણ તપાસો કે તમારો સ્ટોરેજ ભરેલો તો નથી ને?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משהו השתבש. לנסות להפעיל מחדש את האפליקציה? כדאי גם לבדוק אם האחסון מלא?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ गड़बड़ हो गई। ऐप को फिर से शुरू करके देखें? साथ ही देख लें कि कहीं आपका स्टोरेज तो नहीं भर गया?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nešto je pošlo po zlu. Pokušajte ponovno pokrenuti aplikaciju? Također provjerite je li vaš prostor za pohranu pun?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiba történt. Próbálja meg újraindítani az appot. Ellenőrizze azt is, nincs-e tele a tárhelye."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjadi kesalahan. Coba mulai ulang aplikasi? Periksa juga apakah penyimpanan Anda penuh?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa è andato storto. Prova a riavviare l'app. Controlla anche se lo spazio di archiviazione è pieno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題が発生しました。アプリを再起動するか、空き容量を確認してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಏನೋ ತಪ್ಪಾಗಿದೆ. ಆ್ಯಪ್ ಮರುಪ್ರಾರಂಭಿಸಿ ನೋಡುವಿರಾ? ನಿಮ್ಮ ಸಂಗ್ರಹಣೆ ತುಂಬಿದೆಯೇ ಎಂದೂ ಪರಿಶೀಲಿಸಿ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제가 발생했어요. 앱을 다시 시작해 보세요. 저장 공간이 가득 찼는지도 확인해 보세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എന്തോ പിശക് സംഭവിച്ചു. ആപ്പ് വീണ്ടും ആരംഭിച്ചു നോക്കാമോ? സ്റ്റോറേജ് നിറഞ്ഞിട്ടുണ്ടോ എന്നും പരിശോധിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काहीतरी चूक झाली. अ‍ॅप पुन्हा सुरू करून पाहायचे? स्टोरेज भरला आहे का तेही तपासा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada masalah berlaku. Cuba mulakan semula apl? Semak juga jika storan anda penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe gikk galt. Prøv å starte appen på nytt, og sjekk om lagringsplassen er full."
