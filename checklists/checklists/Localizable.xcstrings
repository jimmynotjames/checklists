        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud on poistettu käytöstä tässä laitteessa Näytön aika- tai organisaation hallinnassa. Luettelosi on tallennettu vain tähän laitteeseen."
