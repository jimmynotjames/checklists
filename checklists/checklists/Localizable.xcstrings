            "value" : "Anonymní data o používání zůstanou vypnutá. Později to můžete změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder anonyme brugsdata slået fra. Du kan ændre det senere i Indstillinger."
