        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندرونِ ملک پرواز کے لیے شناختی کارڈ، بیرونِ ملک کے لیے پاسپورٹ، گاڑی کے سفر پر ڈرائیونگ لائسنس۔"
