        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app peut envoyer des données d'utilisation anonymes qui aident à résoudre les problèmes et à comprendre l'utilisation. Les données ne sont jamais liées à ton Compte Apple. Ne sont jamais inclus : les noms des éléments de liste, les notes d'éléments ou les identifiants Apple ou iCloud. Tu peux modifier ce paramètre n'importe quand dans Réglages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
