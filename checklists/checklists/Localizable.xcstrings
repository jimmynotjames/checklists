    "sample.weekendGetaway.item4.notes" : {
      "comment" : "Note under the toiletries packing item about the airline liquids rule.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبوات سوائل صغيرة في كيس منفصل إن كانت في حقيبة اليد بالطائرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্লাইটে হ্যান্ড ব্যাগে তরল ছোট বোতলে, আলাদা ব্যাগে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líquids petits, en una bossa a part si vas amb avió i equipatge de mà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při letu jen malé tekutiny v sáčku v příručním zavazadle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun små væsker i en separat pose, hvis du flyver med håndbagage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Handgepäck nur kleine Flüssigkeiten im extra Beutel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο μικρά υγρά σε ξεχωριστό σακουλάκι αν πετάς με χειραποσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small liquids only in separate bag if flying and in carry-on."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquids under 100 ml in a clear bag if you're flying international with carry-on."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small liquids only, in a separate bag if flying carry-on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquids in a small clear bag if they're going in your hand luggage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líquidos pequeños en bolsa aparte si vuelas con equipaje de mano."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vuelas con equipaje de mano, líquidos pequeños en bolsa aparte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lennolla nesteet pikkupulloissa omassa pussissa käsimatkatavarassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cabine, petits flacons de liquides dans un sac à part."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avion : petits liquides dans un sac séparé, en bagage à main."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફ્લાઇટમાં હેન્ડબેગ લઈ જાઓ તો પ્રવાહી નાની બોટલમાં, અલગ થેલીમાં જ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נוזלים בכמות קטנה בשקית נפרדת אם טסים עם כבודת יד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ्लाइट के केबिन बैग में सिर्फ़ छोटी शीशियाँ, अलग पाउच में रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U ručnoj prtljazi samo male bočice tekućine u prozirnoj vrećici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repülőn kézipoggyászban csak kis flakonok, külön zacskóban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cairan ukuran kecil dipisah di kantong bening kalau bawa kabin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquidi piccoli in busta trasparente se voli con il bagaglio a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飛行機の機内持ち込みは、液体を小分けにして透明の袋にまとめます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಿಮಾನದಲ್ಲಿ ಕೈಚೀಲ ಇದ್ದರೆ ಸಣ್ಣ ಬಾಟಲಿಯ ದ್ರವಗಳನ್ನು ಪ್ರತ್ಯೇಕ ಚೀಲದಲ್ಲಿ ಇಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기내에 들고 탈 땐 액체류를 100ml 이하로 소분해 따로 담아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിമാനയാത്രയാണെങ്കിൽ ദ്രാവകങ്ങൾ ചെറിയ കുപ്പിയിൽ, പ്രത്യേക ബാഗിൽ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विमानाने जाणार असाल तर छोट्या बाटल्या वेगळ्या पिशवीत ठेवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cecair kecil sahaja dalam beg berasingan jika naik kapal terbang dan bawa ke kabin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små væsker i egen pose hvis du flyr med håndbagasje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vloeistoffen alleen klein en in een apart zakje in je handbagage."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିମାନରେ ଯାଉଥିଲେ ଅଳ୍ପ ତରଳ ପଦାର୍ଥ ଅଲଗା ବ୍ୟାଗରେ ହ୍ୟାଣ୍ଡ ବ୍ୟାଗେଜରେ ରଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਹਾਜ਼ 'ਤੇ ਹੱਥ ਵਾਲੇ ਬੈਗ ਵਿੱਚ ਸਿਰਫ਼ ਛੋਟੀਆਂ ਸ਼ੀਸ਼ੀਆਂ, ਵੱਖਰੇ ਬੈਗ ਵਿੱਚ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe płyny w osobnej torebce, jeśli lecisz z bagażem podręcznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só líquidos pequenos, em saco separado, se for de avião e na bagagem de mão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fores de avião, líquidos pequenos em saco à parte na bagagem de mão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichide mici, în pungă separată, dacă zbori cu bagaj de mână."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ручную кладь — только маленькие флаконы в отдельном пакете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri lete v príručnej batožine len malé balenia tekutín vo vrecku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če letiš, male tekočine v ločeni vrečki v ročni prtljagi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara små flaskor i separat påse om du flyger med handbagage."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விமானப் பயணமெனில், கைப்பையில் சிறிய அளவு திரவங்களை தனிப் பையில் வைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విమానంలో క్యారీ-ఆన్ అయితే లిక్విడ్స్ చిన్న సీసాల్లో, విడిగా ఒక బ్యాగ్‌లో."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าถือขึ้นเครื่อง ของเหลวต้องขวดเล็กและแยกใส่ถุงใส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçakta el bagajındaysa sıvılar küçük ve ayrı poşette olsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рідини — лише маленькі флакони в окремому пакеті, якщо летите з ручною поклажею."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاز میں ہینڈ کیری ہو تو مائع اشیا چھوٹی بوتلوں میں الگ تھیلی میں رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bay, chất lỏng nhỏ để riêng túi trong hành lý xách tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐飞机随身带时，液体单瓶不超100毫升，装在透明袋里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搭飛機帶手提行李時，液體分裝小瓶並裝在透明夾鏈袋。"
          }
        }
      }
    },
