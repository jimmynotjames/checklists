        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি নতুন করে ইনস্টল করা হয়েছে এমনভাবে শুরু করে। এই ডিভাইসের সব ডেটা মুছে যাবে।"
