    "settings.icloud.footer.needsAttention" : {
      "comment" : "Footer under the iCloud section when the account is temporarily unavailable. 'Settings' here means the iOS Settings app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الإعدادات وأكد حساب Apple لاستئناف المزامنة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক আবার চালু করতে সেটিংস খুলে আপনার Apple অ্যাকাউন্ট নিশ্চিত করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre Configuració i confirma el teu Compte d'Apple per reprendre la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Nastavení a potvrďte svůj Účet Apple, aby synchronizace mohla pokračovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Indstillinger og bekræft din Apple-konto for at genoptage synkroniseringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen und bestätige deinen Apple-Account, um die Synchronisierung fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τις Ρυθμίσεις και επιβεβαιώστε τον Λογαριασμό Apple σας για να συνεχιστεί ο συγχρονισμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes y confirma tu Cuenta de Apple para reanudar la sincronización."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Configuración y confirma tu Cuenta de Apple para reanudar la sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Asetukset ja vahvista Apple-tilisi synkronoinnin jatkamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages et confirmez votre Compte Apple pour reprendre la synchronisation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages et confirmez votre Compte Apple pour reprendre la synchronisation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સિંક ફરી શરૂ કરવા માટે સેટિંગ્સ ખોલો અને તમારા Apple Account ની પુષ્ટિ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לחדש את הסנכרון, יש לפתוח את ״הגדרות״ ולאשר את חשבון Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ खोलें और अपने Apple खाते की पुष्टि करके सिंक दोबारा शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Postavke i potvrdite svoj Apple račun kako biste nastavili sa sinkronizacijom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a Beállításokat, és erősítse meg Apple-fiókját a szinkronizálás folytatásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Pengaturan dan konfirmasikan Akun Apple Anda untuk melanjutkan sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Impostazioni e conferma il tuo Account Apple per riprendere la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を開いてAppleアカウントを確認して、同期を再開してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆದು ನಿಮ್ಮ Apple ಖಾತೆಯನ್ನು ಖಚಿತಪಡಿಸಿ ಸಿಂಕ್ ಮುಂದುವರೆಸಲು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 열어 Apple 계정을 확인해 동기화를 재개해 주세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്രമീകരണങ്ങൾ തുറന്ന് നിങ്ങളുടെ Apple അക്കൗണ്ട് സ്ഥിരീകരിച്ച് സിങ്ക് പുനരാരംഭിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक पुन्हा सुरू करण्यासाठी सेटिंग्ज उघडा आणि तुमचे Apple खाते कन्फर्म करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Tetapan dan sahkan Akaun Apple anda untuk meneruskan penyegerakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Innstillinger og bekreft Apple-kontoen din for å gjenoppta synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen en bevestig je Apple Account om synchronisatie voort te zetten."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଟିଙ୍ଗ୍ସ ଖୋଲି ଆପଣଙ୍କ Apple ଆକାଉଣ୍ଟ ନିଶ୍ଚିତ କରି ସିଙ୍କ୍ ଚାଲୁ ରାଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿੰਕ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ ਅਤੇ ਆਪਣੇ Apple ਖਾਤੇ ਦੀ ਪੁਸ਼ਟੀ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Ustawienia i potwierdź Konto Apple, aby wznowić synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Ajustes e confirme sua Conta Apple para retomar a sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra as Definições e confirme a sua Conta Apple para retomar a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschideți Configurări și confirmați Contul Apple pentru a relua sincronizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Настройки и подтвердите свой Аккаунт Apple, чтобы возобновить синхронизацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorte Nastavenia a potvrďte svoj Apple Account, aby sa synchronizácia obnovila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
