    "consent.action.accept.hint" : {
      "comment" : "VoiceOver hint for the accept button on the analytics consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفعّل مشاركة بيانات الاستخدام المجهولة لمساعدة التطبيق على التحسّن. لا يتم تضمين أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ উন্নত করতে সাহায্য করতে বেনামি ব্যবহারের ডেটা চালু করে। চেকলিস্ট আইটেমের নাম, আইটেম নোট, বা Apple বা iCloud পরিচয় কখনও অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa les dades d'ús anònimes per ajudar a millorar l'aplicació. Les dades mai inclouen noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne anonymní data o používání, která pomáhají vylepšovat aplikaci. Nikdy nejsou zahrnuty názvy položek kontrolních seznamů, poznámky k položkám ani identifikátory Apple nebo iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår anonyme brugsdata til, så appen kan blive bedre. Navne på tjeklistepunkter, noter til punkter og Apple- eller iCloud-id'er er aldrig med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert anonyme Nutzungsdaten, um die App zu verbessern. Namen von Checklisten-Einträgen, Eintragsnotizen oder Apple- und iCloud-Kennungen sind nie enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί τα ανώνυμα δεδομένα χρήσης για να βοηθήσει στη βελτίωση της εφαρμογής. Δεν περιλαμβάνονται ποτέ ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el envío de datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el envío de datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottaa käyttöön anonyymit käyttötiedot sovelluksen parantamiseksi. Tarkistuslistan kohdan nimiä, kohdan muistiinpanoja tai Apple- tai iCloud-tunnuksia ei koskaan sisällytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active l'envoi de données d'utilisation anonymes pour améliorer l'application. Aucun nom d'élément, aucune note d'élément, ni identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les données d'utilisation anonymes pour aider à améliorer l'application. Aucun nom d'élément de liste de vérification, aucune note d'élément ni aucun identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એપ સુધારવામાં મદદ કરવા અનામી ઉપયોગ ડેટા ચાલુ કરે છે. તેમાં ચેકલિસ્ટ આઇટમનાં નામ, આઇટમ નોંધ અથવા Apple કે iCloud ઓળખકર્તાનો ક્યારેય સમાવેશ થતો નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל נתוני שימוש אנונימיים שעוזרים לשפר את האפליקציה. שמות פריטים, הערות פריטים ומזהי Apple או iCloud אף פעם לא נכללים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को बेहतर बनाने के लिए अनाम उपयोग डेटा चालू करता है। चेकलिस्ट आइटम के नाम, आइटम नोट्स, या Apple या iCloud पहचानकर्ता कभी शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključuje anonimne podatke o upotrebi kako bi pomogli poboljšati aplikaciju. Nikada nisu uključeni nazivi stavki kontrolnog popisa, bilješke stavki ni Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsolja az anonim használati adatok küldését az app fejlesztésének segítésére. Soha nem tartalmaz ellenőrzőlistaelem-nevet, elemjegyzetet vagy Apple-, illetve iCloud-azonosítót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan data penggunaan anonim untuk membantu meningkatkan aplikasi. Nama item daftar periksa, catatan item, atau pengenal Akun Apple maupun iCloud tidak pernah disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la condivisione dei dati di utilizzo anonimi per aiutare a migliorare l'app. Non vengono mai inclusi i nomi degli elementi, le note o gli identificatori di Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの改善に役立つ匿名の使用状況データを有効にします。チェックリスト項目の名前、項目のメモ、AppleまたはiCloudの識別子は含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ್ಯಪ್ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡುವ ಅನಾಮಧೇಯ ಬಳಕೆ ಡೇಟಾ ಆನ್ ಮಾಡುತ್ತದೆ. ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಟಿಪ್ಪಣಿಗಳು, ಅಥವಾ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳನ್ನು ಎಂದಿಗೂ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 사용 데이터를 켜서 앱 개선을 도와요. 체크리스트 항목 이름, 항목 메모, Apple 또는 iCloud 식별자는 절대 포함되지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആപ്പ് മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്ന അജ്ഞാത ഉപയോഗ ഡാറ്റ ഓണാക്കുന്നു. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകളോ കുറിപ്പുകളോ Apple അല്ലെങ്കിൽ iCloud ഐഡന്റിഫയറുകളോ ഒരിക്കലും ഉൾപ്പെടുത്തില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अ‍ॅप सुधारण्यासाठी अनामिक वापर डेटा सुरू करते. यात चेकलिस्ट आयटमची नावे, आयटम टिपा किंवा Apple किंवा iCloud आयडेंटिफायर्स कधीही समाविष्ट केले जात नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghidupkan data penggunaan tanpa nama untuk membantu meningkatkan aplikasi. Nama item senarai semak, nota item, atau pengecam Apple atau iCloud tidak pernah disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår på anonyme bruksdata som bidrar til å forbedre appen. Verken navn på sjekklistepunkter, notater eller Apple- eller iCloud-identifikatorer inkluderes noensinne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt anonieme gebruiksgegevens in om de app te helpen verbeteren. Namen en notities van items en Apple- of iCloud-ID's worden nooit meegestuurd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପ୍ ଉନ୍ନତ କରିବାରେ ସାହାଯ୍ୟ ପାଇଁ ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ତଥ୍ୟ ଚାଲୁ କରେ। ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ଟିପ୍ପଣୀ, କିମ୍ବା Apple ବା iCloud ଆଇଡେଣ୍ଟିଫାୟର୍ କେବେହେଲେ ଅନ୍ତର୍ଭୁକ୍ତ ହୁଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਚਾਲੂ ਕਰਦਾ ਹੈ। ਕਦੇ ਵੀ ਚੈੱਕਲਿਸਟ ਆਈਟਮ ਦੇ ਨਾਂ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ Apple ਜਾਂ iCloud ਪਛਾਣਕਾਰ ਸ਼ਾਮਿਲ ਨਹੀਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza anonimowe dane o użytkowaniu, które pomagają ulepszać aplikację. Nigdy nie obejmują nazw pozycji, notatek ani identyfikatorów Apple lub iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa dados de uso anônimos para ajudar a melhorar o app. Nomes de itens do checklist, notas de itens ou identificadores Apple ou iCloud nunca são incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa os dados de utilização anónimos para ajudar a melhorar a aplicação. Nunca são incluídos nomes de itens de listas de verificação, notas de itens, nem identificadores da Apple ou do iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează trimiterea de date anonime de utilizare pentru a ajuta la îmbunătățirea aplicației. Nu sunt incluse niciodată numele elementelor din listele de verificare, notițele elementelor sau identificatori Apple sau iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает отправку анонимных данных об использовании, которые помогают улучшать приложение. Названия пунктов чек-листа, заметки к пунктам и идентификаторы Apple или iCloud никогда не передаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne odosielanie anonymných údajov o používaní na zlepšenie aplikácie. Nikdy nie sú zahrnuté názvy položiek kontrolného zoznamu, poznámky k položkám ani identifikátory Apple alebo iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopi anonimne podatke o uporabi, ki pomagajo izboljšati aplikacijo. Nikoli niso vključeni imena postavk, opombe postavk ali identifikatorji Apple oziroma iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverar anonym användningsdata som hjälper till att förbättra appen. Namn på checklistpunkter, anteckningar eller Apple- eller iCloud-identifierare ingår aldrig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயலியை மேம்படுத்த உதவும் அநாமதேய பயன்பாட்டுத் தரவை இயக்கும். சரிபார்ப்புப் பட்டியல் உருப்படிப் பெயர்கள், உருப்படிக் குறிப்புகள், Apple அல்லது iCloud அடையாளங்கள் ஏதும் சேர்க்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్‌ను మెరుగుపరచడానికి అనామక వినియోగ డేటాను ఆన్ చేస్తుంది. చెక్‌లిస్ట్ అంశాల పేర్లు, అంశాల గమనికలు, లేదా Apple లేదా iCloud గుర్తింపులు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุงแอป ไม่มีการรวมชื่อรายการเช็คลิสต์ หมายเหตุรายการ หรือตัวระบุ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı geliştirmeye yardımcı olmak için anonim kullanım verilerini açar. Kontrol listesi öğe adları, öğe notları veya Apple ya da iCloud kimlikleri asla dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вмикає надсилання анонімних даних про використання, щоб допомогти покращити застосунок. Назви пунктів чек-листа, нотатки до пунктів та ідентифікатори Apple чи iCloud ніколи не передаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو بہتر بنانے میں مدد کے لیے گمنام استعمال کا ڈیٹا چالو کرتا ہے۔ چیک لسٹ آئٹم کے نام، آئٹم نوٹس، یا Apple یا iCloud شناخت کی معلومات کبھی شامل نہیں ہوتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Không bao giờ có tên mục, ghi chú mục hoặc mã định danh Apple hay iCloud nào được gửi kèm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用匿名使用数据以帮助改进应用。永远不包含清单项目名称、项目备注或 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟匿名使用資料，協助改進應用程式。絕不包含檢查清單項目名稱、項目備註或任何 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
