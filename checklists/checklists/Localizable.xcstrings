          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud je na tomto zariadení vypnutý aplikáciou Screen Time alebo vašou organizáciou. Vaše zoznamy sú uložené len na tomto zariadení."
