        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속할까요? 되돌릴 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഉറപ്പാണോ? ഇത് പഴയപടിയാക്കാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला खात्री आहे? हे मागे घेता येणार नाही।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda pasti? Ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker? Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Dit kan niet ongedaan worden gemaakt."
