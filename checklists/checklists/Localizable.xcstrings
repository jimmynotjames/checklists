    "sample.weekendGetaway.item4.notes" : {
      "comment" : "Note under the toiletries packing item about the airline liquids rule.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السوائل الصغيرة فقط، في كيس منفصل بحقيبة اليد عند السفر جوًّا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেনের হ্যান্ড লাগেজে তরল শুধু ছোট বোতলে, আলাদা ব্যাগে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vas en avió amb maleta de mà, líquids petits en bossa a part."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při letu: tekutiny do 100 ml v sáčku v příručním zavazadle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun små væsker, i en separat pose i håndbagagen ved fly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fliegen: Flüssigkeiten im Handgepäck nur klein und im extra Beutel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υγρά έως 100 ml σε διάφανο σακουλάκι, για πτήση με χειραποσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small liquids only in separate bag if flying and in carry-on."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquids 100 ml or less in a clear bag in carry-on if flying overseas."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If flying carry-on: liquids 100 mL or less, in one clear resealable bag."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquids 100ml max in a clear bag if flying with hand luggage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avión con equipaje de mano: líquidos pequeños en bolsa aparte."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líquidos chicos en bolsa aparte si vuelo con equipaje de mano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lentäessä nesteet pieninä pakkauksina omaan pussiin käsimatkatavaroihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avion, petits flacons de liquides dans un sachet à part, en cabine."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avion : petits liquides dans un sac à part, en bagage de cabine."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફ્લાઇટમાં કેબિન બેગ હોય તો નાની પ્રવાહી બોટલો અલગ પાઉચમાં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטיסה: נוזלים בכמות קטנה בלבד, בשקית נפרדת בתיק היד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लाइट में केबिन बैग हो तो लिक्विड छोटी बोतलों में, अलग बैग में।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za let u ručnoj prtljazi: male tekućine u zasebnoj vrećici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repülőn a kézipoggyászban csak kis kiszerelésű folyadék, külön tasakban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika naik pesawat, cairan ukuran kecil di kantong terpisah dalam bagasi kabin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquidi in piccoli flaconi, in una bustina a parte nel bagaglio a mano se si vola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機内持ち込みの液体は100ml以下の容器にして透明な袋へ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಿಮಾನದಲ್ಲಿ ಹ್ಯಾಂಡ್ ಬ್ಯಾಗ್‌ಗೆ ಸಣ್ಣ ದ್ರವ ಬಾಟಲಿ ಮಾತ್ರ, ಬೇರೆ ಚೀಲದಲ್ಲಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비행기 탈 땐 기내 반입 액체류 100ml 이하로 지퍼백에 따로."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഫ്ലൈറ്റിൽ ഹാൻഡ് ബാഗിൽ ചെറിയ കുപ്പികൾ മാത്രം, പ്രത്യേക കവറിൽ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विमानाने जाताना केबिन बॅगेत फक्त लहान बाटल्या, वेगळ्या पिशवीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika naik kapal terbang: cecair kecil dalam beg berasingan, bawa dalam kabin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved flyreise: små flasker i egen pose i håndbagasjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vliegen met handbagage: kleine flesjes in een apart zakje."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିମାନରେ ଗଲେ ହ୍ୟାଣ୍ଡ ବ୍ୟାଗରେ କେବଳ ଛୋଟ ତରଳ ଜିନିଷ, ଅଲଗା ବ୍ୟାଗରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਫ਼ਲਾਈਟ 'ਚ ਹੈਂਡ ਬੈਗ ਲਈ ਛੋਟੀਆਂ ਸ਼ੀਸ਼ੀਆਂ ਹੀ, ਵੱਖਰੇ ਲਿਫ਼ਾਫ਼ੇ 'ਚ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W samolocie: płyny do 100 ml w osobnym woreczku w podręcznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na bagagem de mão, só líquidos de até 100 ml em saquinho transparente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líquidos até 100 ml num saco à parte na bagagem de mão, se for de avião."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar lichide mici, în pungă separată, la bagajul de mână în avion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В самолёт с ручной кладью — жидкости до 100 мл в отдельном пакете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri lete s príručnou batožinou malé tekutiny zvlášť vo vrecku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri letenju: tekočine le v majhni embalaži, v ločeni vrečki v ročni prtljagi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyg: små flaskor i separat påse i handbagaget."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விமானம் என்றால் சிறிய திரவங்கள் மட்டும், கேபின் பையில் தனிப் பையில்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విమానంలో క్యాబిన్ బ్యాగ్‌కైతే చిన్న లిక్విడ్‌లే, విడిగా ఓ కవర్‌లో."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ของเหลวขวดละไม่เกิน 100 มล. ใส่ถุงใสแยกไว้ ถ้าถือขึ้นเครื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçakla gidilecekse sıvılar küçük şişede, ayrı poşette, kabinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рідини до 100 мл — окремим пакетом у ручну поклажу, якщо літаком."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہوائی سفر میں دستی سامان کے مائعات چھوٹی بوتلوں میں، الگ تھیلی میں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đi máy bay, chất lỏng loại nhỏ để túi riêng trong hành lý xách tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐飞机的话，随身液体只带小瓶，单独装袋。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搭飛機的話，隨身行李的液體用小瓶裝，另放透明夾鏈袋。"
          }
        }
      }
    },
