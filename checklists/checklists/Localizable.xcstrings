    "toast.saveFailed" : {
      "comment" : "Error toast shown when a change could not be written to the device. Full storage is the likely cause but not a certain one — a damaged database fails the same way — so the second sentence must stay a guess (\"may\"), never a statement of fact. Appears briefly at the bottom of the screen with no button. Keep it short; it can appear after any edit (adding, ticking, renaming, deleting).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الحفظ. قد تكون مساحة التخزين منخفضة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষণ করা যায়নি। ডিভাইসের স্টোরেজ কম থাকতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut desar. Pot ser que el dispositiu tingui poc espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložení se nezdařilo. V zařízení může docházet místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gemme. Din enhed har muligvis lav lagerplads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern fehlgeschlagen. Möglicherweise ist der Speicher deines Geräts knapp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποθήκευση απέτυχε. Ο χώρος της συσκευής ίσως είναι χαμηλός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save failed. Your device may be low on storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado. Puede que el dispositivo tenga poco espacio."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar. Tu dispositivo podría tener poco espacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus epäonnistui. Laitteen tallennustila voi olla vähissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’enregistrement. Votre appareil manque peut-être d’espace."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'enregistrement. Votre appareil manque peut-être d'espace."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાચવી શકાયું નહીં. તમારા ડિવાઇસમાં સ્ટોરેજ ઓછું હોઈ શકે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השמירה נכשלה. ייתכן שנגמר מקום האחסון במכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव नहीं हो सका। हो सकता है आपके डिवाइस में स्टोरेज कम हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremanje nije uspjelo. Na uređaju bi moglo biti malo prostora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentés nem sikerült. Lehet, hogy kevés a tárhely."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menyimpan. Penyimpanan perangkat Anda mungkin hampir penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvataggio non riuscito. Lo spazio sul dispositivo potrebbe essere in esaurimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存できませんでした。デバイスの空き容量が少ない可能性があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಳಿಸಲಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಕಡಿಮೆ ಇರಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 못했어요. 기기의 저장 공간이 부족할 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സേവ് ചെയ്യാനായില്ല. ഉപകരണത്തിൽ സ്റ്റോറേജ് കുറവായിരിക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
