        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud ezen az eszközön ki van kapcsolva a Képernyőidő vagy a szervezet által. Az ellenőrző listák csak ezen az eszközön lesznek mentve."
