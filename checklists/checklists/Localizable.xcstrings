        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਚੈੱਕ ਕਰੋ। ਤੁਹਾਡੀਆਂ ਚੈਕਲਿਸਟਾਂ ਇਸ ਡਿਵਾਈਸ ਤੇ ਸੁਰੱਖਿਅਤ ਹਨ।"
          }
        },
        "pl" : {
