    "loading.cloudSyncNote" : {
      "comment" : "Footnote under the migration message when the migrated data will start syncing through iCloud.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم مزامنة قوائم التحقق الخاصة بك الآن عبر أجهزتك من خلال iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চেকলিস্ট এখন iCloud-এর মাধ্যমে আপনার ডিভাইস জুড়ে সিঙ্ক করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves llistes de comprovació ara es sincronitzaran entre els teus dispositius a través de l'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje seznamy se budou synchronizovat mezi tvými zařízeními přes iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine tjeklister synkroniseres nu på tværs af dine enheder via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Checklisten werden nun über iCloud auf deinen Geräten synchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λίστες ελέγχου σας θα συγχρονίζονται πλέον σε όλες τις συσκευές σας μέσω iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
