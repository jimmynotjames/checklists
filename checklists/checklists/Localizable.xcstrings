        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak sambungan internet anda. Senarai semak anda disimpan pada peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk internettforbindelsen din. Sjekklistene dine er lagret på denne enheten."
