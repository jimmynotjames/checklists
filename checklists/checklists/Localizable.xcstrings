    "containerFailure.confirm.message" : {
      "comment" : "Message of the confirmation alert before deleting local data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التطبيق كما لو تم تثبيته للتو. سيتم فقدان أي بيانات على هذا الجهاز. لا يمكن التراجع عن هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি অ্যাপটি নতুনভাবে ইনস্টল করার মতো শুরু করে। এই ডিভাইসে সব ডেটা হারিয়ে যাবে। এটি বাতিল করা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això inicia l'aplicació com si acabés d'instal·lar-se. Es perdran totes les dades d'aquest dispositiu. Això no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto spustí aplikaci tak, jako by byla nově nainstalována. Všechna data v tomto zařízení budou ztracena. Toto se nedá vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nylig installeret. Alle data på denne enhed går tabt. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies startet die App neu wie bei einer Neuinstallation. Alle Daten auf diesem Gerät gehen verloren. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό ξεκινά την εφαρμογή σαν να ήταν νεοεγκατεστημένη. Τυχόν δεδομένα σε αυτή τη συσκευή θα χαθούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si fuera una instalación nueva. Se perderán todos los datos en este dispositivo. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si fuera una nueva instalación. Se perderán todos los datos en este dispositivo. Esto no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä käynnistää sovelluksen ikään kuin se olisi juuri asennettu. Kaikki laitteen tiedot menetetään. Tätä ei voi peruuttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela lance l'app comme si elle venait d'être installée. Toutes les données sur cet appareil seront supprimées. Cette action ne peut pas être annulée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci démarre l'application comme si elle venait d'être installée. Toutes les données sur cet appareil seront perdues. Cela ne peut pas être annulé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ એપ્લીકેશનને નવી તરીકે શરૂ કરે છે. આ ઉપકરણ પરનો કોઈપણ ડેટા ગુમ થશે. આ રદ કરી શકાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מפעיל את האפליקציה כאילו היא מותקנת לראשונה. כל הנתונים בהתקן זה יאבדו. לא ניתן לבטל את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप को ऐसे शुरू करता है जैसे यह नया इंस्टॉल हो। इस डिवाइस पर कोई भी डेटा खो जाएगा। यह वापस नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo pokreće aplikaciju kao da je upravo instalirana. Svi podaci na ovom uređaju će biti izbrisani. Ovo se ne može opozvati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez úgy indítja az alkalmazást, mintha újonnan telepítve lenne. Az eszközön lévő összes adat elvész. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memulai aplikasi seolah-olah baru saja diinstal. Data apa pun di perangkat ini akan hilang. Ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia l'app come se fosse appena installata. Tutti i dati su questo dispositivo verranno persi. Non è possibile annullare questa azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを新規インストール時のように起動します。このデバイスのデータが失われます。これは元に戻せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಅ್ಯಾಪ್ ಅನ್ನು ಹೊಸದಾಗಿ ಸ್ಥಾಪಿಸಿರುವಂತೆ ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ಈ ಸಾಧನದಲ್ಲಿ ಡೇಟಾ ಕಳೆದುಹೋಗುವುದು. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 새로 설치된 것처럼 시작됩니다. 이 기기의 모든 데이터가 손실됩니다. 되돌릴 수 없습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് അപ്ലിക്കേഷൻ പുതിയതായി ഇൻസ്റ്റാൾ ചെയ്തതുപോലെ ആരംഭിക്കുന്നു. ഈ ഉപകരണത്തിലെ ഏതെങ്കിലും ഡാറ്റ നഷ്ടപ്പെടും. ഇത് പഴയ നിലയിലേക്കു കൊണ്ടുവരാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे अ्‍ॅप सुरू करते जसे तो नवीनरित्या स्थापित केला गेला असेल। या डिव्हाइसवरील कोणताही डेटा हरवेल। हे मागे घेता येणार नाही।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memulakan aplikasi seolah-olah ia baru dipasang. Sebarang data pada peranti ini akan hilang. Ini tidak boleh dibatalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nylig installert. Alle data på denne enheten vil gå tapt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit start de app alsof deze net is geïnstalleerd. Alle gegevens op dit apparaat gaan verloren. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହାକି ଅ୍ୟାପ୍‍କୁ ନୂତନ ଭାବେ ସ୍ଥାପିତ ଭାବେ ଆରମ୍ଭ କରେ। ଏହି ଡିଭାଇସରେ ଥିବା ଯେକୌଣସି ତଥ୍ୟ ହଜି ଯିବ। ଏହାକୁ ବାତିଲ୍ କରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਐਪ ਨੂੰ ਨਵੀ ਇੰਸਟਾਲ ਵਜੋਂ ਚਾਲੂ ਕਰਦਾ ਹੈ। ਇਸ ਡਿਵਾਈਸ ਉੱਤੇ ਕੋਈ ਵੀ ਡਾਟਾ ਖਤਮ ਹੋ ਜਾਵੇਗਾ। ਇਹ ਖਤਮ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To uruchamia aplikację, jakby była zainstalowana po raz pierwszy. Wszystkie dane na tym urządzeniu zostaną utracone. Nie będzie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso inicia o app como se fosse recém-instalado. Qualquer dado neste dispositivo será perdido. Esta ação não pode ser desfeita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto inicia a aplicação como se tivesse sido recém-instalada. Quaisquer dados neste dispositivo serão perdidos. Isto não pode ser desfeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta pornește aplicația ca și cum ar fi nou instalată. Orice date pe acest dispozitiv vor fi pierdute. Nu se poate anula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это запустит приложение как после новой установки. Все данные на этом устройстве будут удалены. Это действие невозможно отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia sa spustí ako keby bola novo nainštalovaná. Všetky údaje na tomto zariadení budú stratené. Túto akciu nie je možné vrátiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zažene aplikacijo, kot da bi bila novo nameščena. Vsi podatki na tej napravi bodo izgubljeni. To ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här startar appen som om den vore nyinstallerad. All data på den här enheten går förlorad. Det går inte att ångra detta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது பயன்பாட்டை புதிய முறையில் நிறுவப்பட்ட போல் தொடங்குகிறது. இந்த சாதனத்தில் உள்ள எந்த தரவும் இழக்கப்படும். இது செயல்நீக்கம் செய்ய முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది అనువర్తనాన్ని కొత్తగా ఇన్‌స్టాల్ చేసిన విధంగా ప్రారంభిస్తుంది. ఈ పరికరంపై ఏదైనా డేటా కోల్పోతుంది. ఇది రద్దు చేయబడదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งนี้เริ่มแอปเสมือนว่าเป็นการติดตั้งครั้งแรก ข้อมูลทั้งหมดในอุปกรณ์นี้จะหายไป ไม่สามารถเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, uygulamayı yeni yüklenmiş gibi başlatır. Bu cihazdaki tüm veriler kaybolacaktır. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це запустить додаток так, ніби він щойно встановлений. Усі дані на цьому пристрої будуть втрачені. Цю дію неможливо буде скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ایپ کو ایسے شروع کرتا ہے جیسے یہ نئے سرے سے انسٹال ہوا ہو۔ اس ڈیوائس پر کوئی بھی ڈیٹا کھو جائے گا۔ یہ واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này khởi động ứng dụng như thể nó vừa được cài đặt. Mọi dữ liệu trên thiết bị này sẽ bị mất. Thao tác này không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以全新安装的方式启动应用。此设备上的所有数据都将丢失。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以新安裝的方式啟動應用程式。此裝置上的所有資料都會遺失。此操作無法復原。"
          }
        }
      }
    },
