        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל את האפליקציה כאילו הותקנה זה עתה. כל הנתונים במכשיר זה יאבדו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
