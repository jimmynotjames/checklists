          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ନିଶ୍ଚିତ କି? ଏହା ପୁନଃ ପରିବର୍ତ୍ତନ ହୋଇପାରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
