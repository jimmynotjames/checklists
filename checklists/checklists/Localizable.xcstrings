    "containerFailure.confirm.message" : {
      "comment" : "Message of the confirmation alert before deleting local data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التطبيق كما لو تم تثبيته للتو. سيتم فقدان أي بيانات على هذا الجهاز. لا يمكن التراجع عن هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে অ্যাপটি নতুন করে ইনস্টল করার মতো চালু হবে। এই ডিভাইসের সব ডেটা মুছে যাবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això inicia l'aplicació com si acabés d'instal·lar-se. Es perdran totes les dades d'aquest dispositiu. Això no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se spustí, jako by byla nově nainstalovaná. Veškerá data v tomto zařízení budou ztracena. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nylig installeret. Alle data på denne enhed går tabt. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies startet die App neu wie bei einer Neuinstallation. Alle Daten auf diesem Gerät gehen verloren. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό εκκινεί την εφαρμογή σαν να είχε μόλις εγκατασταθεί. Τυχόν δεδομένα σε αυτή τη συσκευή θα χαθούν. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts the app as if it were newly installed. Any data on this device will be lost. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si fuera una instalación nueva. Se perderán todos los datos en este dispositivo. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto inicia la app como si fuera una nueva instalación. Se perderán todos los datos en este dispositivo. Esto no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä käynnistää sovelluksen ikään kuin se olisi juuri asennettu. Kaikki laitteen tiedot menetetään. Tätä ei voi peruuttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela démarre l'application comme si elle venait d'être installée. Toutes les données de cet appareil seront perdues. Cette action est irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela démarre l'application comme si elle venait d'être installée. Toutes les données sur cet appareil seront perdues. Cette action est irréversible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ એપને નવેસરથી ઇન્સ્ટોલ કરેલી હોય તેમ શરૂ કરે છે. આ ડિવાઇસ પરનો તમામ ડેટા ખોવાઈ જશે. આ પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תפעיל את האפליקציה מחדש כאילו הותקנה זה עתה. כל הנתונים במכשיר זה יימחקו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप को ऐसे शुरू करता है जैसे वह अभी इंस्टॉल हुआ हो। इस डिवाइस का सारा डेटा मिट जाएगा। इसे वापस नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo pokreće aplikaciju kao da je tek instalirana. Svi podaci na ovom uređaju bit će izgubljeni. Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez úgy indítja el az appot, mintha most telepítette volna. Az eszközön lévő adatok elvesznek. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memulai aplikasi seolah-olah baru terpasang. Semua data di perangkat ini akan hilang. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app ripartirà come se fosse appena installata. I dati su questo dispositivo andranno persi. L'operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを新規インストール時のように起動します。このデバイスのデータが失われます。これは元に戻せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಆ್ಯಪ್ ಅನ್ನು ಹೊಸದಾಗಿ ಸ್ಥಾಪಿಸಿದಂತೆ ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ಈ ಸಾಧನದಲ್ಲಿನ ಎಲ್ಲಾ ಡೇಟಾ ಕಳೆದುಹೋಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 새로 설치한 것처럼 시작해요. 이 기기의 모든 데이터가 삭제되며 되돌릴 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് ആപ്പ് പുതുതായി ഇൻസ്റ്റാൾ ചെയ്തതു പോലെ ആരംഭിക്കും. ഈ ഉപകരണത്തിലെ എല്ലാ ഡാറ്റയും നഷ്ടപ്പെടും. ഇത് പഴയപടിയാക്കാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे अ‍ॅप नव्याने इन्स्टॉल केल्यासारखे सुरू होईल. या डिव्हाइसवरील सर्व डेटा नष्ट होईल. ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memulakan app seperti baru dipasang. Semua data pada peranti ini akan hilang. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette starter appen som om den var nylig installert. Alle data på denne enheten vil gå tapt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit start de app alsof deze net is geïnstalleerd. Alle gegevens op dit apparaat gaan verloren. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଆପକୁ ନୂଆ ଇନଷ୍ଟଲ୍ ହେଲା ପରି ଆରମ୍ଭ କରିବ। ଏହି ଡିଭାଇସର ସମସ୍ତ ଡାଟା ହଜିଯିବ। ଏହା ଆଉ ଫେରାଇ ହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਐਪ ਨੂੰ ਇਸ ਤਰ੍ਹਾਂ ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ ਜਿਵੇਂ ਇਹ ਹੁਣੇ ਇੰਸਟਾਲ ਹੋਈ ਹੋਵੇ। ਇਸ ਡਿਵਾਈਸ ਦਾ ਸਾਰਾ ਡਾਟਾ ਮਿਟ ਜਾਵੇਗਾ। ਇਹ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To uruchamia aplikację, jakby była zainstalowana po raz pierwszy. Wszystkie dane na tym urządzeniu zostaną utracone. Nie będzie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso inicia o app como se fosse recém-instalado. Qualquer dado neste dispositivo será perdido. Esta ação não pode ser desfeita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto inicia a aplicação como se fosse uma instalação nova. Todos os dados neste dispositivo serão perdidos. Esta ação não pode ser anulada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta pornește aplicația ca și cum ar fi fost instalată din nou. Toate datele de pe acest dispozitiv vor fi pierdute. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение запустится заново, как при первой установке. Все данные на этом устройстве будут потеряны. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto spustí aplikáciu, akoby bola práve nainštalovaná. Všetky údaje v tomto zariadení sa stratia. Túto akciu nemožno vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zažene aplikacijo, kot da bi bila na novo nameščena. Vsi podatki na tej napravi bodo izgubljeni. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här startar appen som om den vore nyinstallerad. All data på den här enheten går förlorad. Det går inte att ångra detta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது செயலியைப் புதிதாக நிறுவியது போல் தொடங்கும். இந்தச் சாதனத்தில் உள்ள தரவு அனைத்தும் இழக்கப்படும். இதைத் திரும்பப் பெற முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది యాప్‌ను కొత్తగా ఇన్‌స్టాల్ చేసినట్లుగా ప్రారంభిస్తుంది. ఈ పరికరంలోని డేటా మొత్తం పోతుంది. దీన్ని వెనక్కి తీసుకోలేరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะเริ่มแอปใหม่เหมือนเพิ่งติดตั้ง ข้อมูลทั้งหมดบนอุปกรณ์นี้จะหายไป และไม่สามารถย้อนกลับได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, uygulamayı yeni yüklenmiş gibi başlatır. Bu cihazdaki tüm veriler kaybolur. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це запустить застосунок, як щойно встановлений. Усі дані на цьому пристрої буде втрачено. Цю дію не можна скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ایپ کو ایسے شروع کرے گا جیسے نئی انسٹال کی گئی ہو۔ اس ڈیوائس پر موجود تمام ڈیٹا ضائع ہو جائے گا۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng sẽ khởi động như thể mới cài đặt lần đầu. Mọi dữ liệu trên thiết bị này sẽ bị mất. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以全新安装的方式启动应用。此设备上的所有数据都将丢失。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以新安裝的方式啟動應用程式。此裝置上的所有資料都會遺失。此操作無法復原。"
          }
        }
      }
    },
