    "containerFailure.action.startOver" : {
      "comment" : "Destructive button on the database-failure screen: deletes the local data and relaunches as a new install.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البدء من جديد"
