        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši kontrolni popisi se čuvaju samo na ovom uređaju. Ponovno pokrenite aplikaciju da pokušate s iCloud sinkronizacijom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ellenőrzőlistáid csak ezen az eszközön vannak mentve. Az alkalmazás újraindításával megpróbálhatod az iCloud-szinkronizálást."
