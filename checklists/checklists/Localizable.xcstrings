        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயன்பாட்டை புதிய முறையில் நிறுவப்பட்ட போல் தொடங்குகிறது. இந்த சாதனத்தில் உள்ள எந்த தரவும் இழக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనువర్తనాన్ని కొత్తగా ఇన్‌స్టాల్ చేసిన విధంగా ప్రారంభిస్తుంది. ఈ పరికరంపై ఏదైనా డేటా కోల్పోతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
