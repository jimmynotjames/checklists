    "settings.analytics.footer" : {
      "comment" : "Footer under the analytics section explaining what usage data is and is not collected.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد بيانات الاستخدام المجهولة الهوية في معالجة المشكلات وفهم طريقة الاستخدام. لا ترتبط البيانات أبدًا بحساب Apple الخاص بك. لا يتم تضمين أسماء عناصر القوائم أو ملاحظاتها أو أي معرّفات من Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেনামী ব্যবহারের ডেটা সমস্যা খুঁজে বের করতে ও ব্যবহার বুঝতে সাহায্য করে। ডেটা কখনও আপনার Apple অ্যাকাউন্টের সাথে যুক্ত করা হয় না। কখনও অন্তর্ভুক্ত নয়: চেকলিস্টের আইটেমের নাম, আইটেমের নোট, বা Apple ও iCloud-এর কোনো শনাক্তকারী।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades d'ús anònimes ajuden a resoldre problemes i a entendre com s'usa l'app. Les dades mai s'associen al teu Compte d'Apple. No s'hi inclou mai cap nom d'element, cap nota ni cap identificador d'Apple o d'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymní data o používání pomáhají řešit potíže a pochopit, jak se aplikace používá. Data nikdy nejsou propojena s vaším Apple účtem. Nikdy nezahrnují názvy položek seznamů, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme brugsdata hjælper med at finde fejl og forstå, hvordan appen bruges. Data bliver aldrig knyttet til din Apple-konto. Medtages aldrig: navne på tjeklistepunkter, noter eller Apple- og iCloud-id'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsdaten helfen, Probleme zu beheben und die Nutzung zu verstehen. Die Daten werden nie mit deinem Apple Account verknüpft. Nie enthalten: Namen und Notizen von Einträgen sowie Apple- oder iCloud-Kennungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ανώνυμα δεδομένα χρήσης βοηθούν στην αντιμετώπιση προβλημάτων και στην κατανόηση της χρήσης. Τα δεδομένα δεν συνδέονται ποτέ με τον Λογαριασμό σας Apple. Δεν περιλαμβάνονται ποτέ: ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de uso anónimos ayudan a resolver problemas y a entender cómo se usa la app. Los datos nunca se vinculan a tu Cuenta de Apple. Nunca se incluyen nombres ni notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de uso anónimos ayudan a resolver problemas y a entender cómo se usa la app. Los datos nunca se vinculan con tu Cuenta de Apple. Nunca se incluyen nombres de elementos, notas de elementos ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyymit käyttötiedot auttavat ongelmien selvittämisessä ja käytön ymmärtämisessä. Tietoja ei koskaan yhdistetä Apple-tiliisi. Mukaan ei koskaan oteta tarkistuslistan kohtien nimiä, kohtien muistiinpanoja eikä Apple- tai iCloud-tunnisteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d'utilisation anonymes aident à résoudre des problèmes et à comprendre l'usage. Elles ne sont jamais liées à votre compte Apple. Jamais incluses : noms d'éléments, notes d'éléments, ni aucun identifiant Apple ou iCloud."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d'utilisation anonymes aident à résoudre des problèmes et à comprendre l'utilisation. Ces données ne sont jamais associées à votre compte Apple. Jamais incluses : les noms d'éléments, les notes d'éléments, ni aucun identifiant Apple ou iCloud."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અનામી વપરાશ ડેટા સમસ્યાઓ ઉકેલવામાં અને વપરાશ સમજવામાં મદદ કરે છે. ડેટા ક્યારેય તમારા Apple એકાઉન્ટ સાથે જોડાયેલો નથી. આમાં ક્યારેય સામેલ નથી: ચેકલિસ્ટ આઇટમના નામ, આઇટમની નોંધો, કે કોઈ Apple અથવા iCloud ઓળખકર્તા."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני שימוש אנונימיים עוזרים לאתר תקלות ולהבין את השימוש. הנתונים לעולם אינם מקושרים לחשבון Apple שלך. לעולם לא נכללים: שמות של פריטים, הערות לפריטים או מזהים של Apple או iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनाम उपयोग डेटा से समस्याएँ सुलझाने और उपयोग को समझने में मदद मिलती है। डेटा कभी भी आपके Apple खाते से नहीं जोड़ा जाता। कभी शामिल नहीं: चेकलिस्ट आइटम के नाम, आइटम नोट्स, या कोई भी Apple या iCloud पहचानकर्ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimni podaci o korištenju pomažu u otklanjanju problema i razumijevanju korištenja. Podaci se nikada ne povezuju s vašim Apple računom. Nikada se ne uključuju: nazivi stavki popisa, bilješke stavki ni bilo kakvi Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az anonim használati adatok segítenek a hibák elhárításában és a használat megértésében. Az adatokat soha nem kapcsoljuk az Apple-fiókjához. Soha nem kerülnek bele: listaelemek nevei, elemjegyzetek, valamint Apple- vagy iCloud-azonosítók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data penggunaan anonim membantu mengatasi masalah dan memahami penggunaan. Data tidak pernah dikaitkan dengan Akun Apple Anda. Tidak pernah disertakan: nama item daftar periksa, catatan item, atau pengenal Apple maupun iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di utilizzo anonimi aiutano a risolvere i problemi e a capire come viene usata l'app. I dati non sono mai collegati al tuo Account Apple. Non vengono mai inclusi: nomi delle voci, note delle voci o identificatori Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名の使用状況データは、問題の調査や使われ方の把握に役立ちます。データがAppleアカウントに紐づけられることはありません。チェックリストの項目名、項目のメモ、AppleやiCloudの識別子は含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅನಾಮಧೇಯ ಬಳಕೆಯ ಡೇಟಾ ಸಮಸ್ಯೆಗಳನ್ನು ಪತ್ತೆಹಚ್ಚಲು ಮತ್ತು ಬಳಕೆಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಈ ಡೇಟಾವನ್ನು ನಿಮ್ಮ Apple ಖಾತೆಗೆ ಎಂದಿಗೂ ಲಿಂಕ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ. ಎಂದಿಗೂ ಸೇರಿಸದ್ದು: ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಐಟಂ ಟಿಪ್ಪಣಿಗಳು, ಅಥವಾ ಯಾವುದೇ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 사용 데이터는 문제 해결과 사용 현황 파악에 도움이 돼요. 데이터는 Apple 계정과 절대 연결되지 않아요. 체크리스트 항목 이름, 항목 메모, Apple 또는 iCloud 식별자는 포함되지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അജ്ഞാത ഉപയോഗ ഡാറ്റ പ്രശ്നങ്ങൾ കണ്ടെത്താനും ഉപയോഗം മനസ്സിലാക്കാനും സഹായിക്കുന്നു. ഈ ഡാറ്റ നിങ്ങളുടെ Apple അക്കൗണ്ടുമായി ഒരിക്കലും ബന്ധിപ്പിക്കില്ല. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകൾ, ഇനങ്ങളുടെ കുറിപ്പുകൾ, Apple അല്ലെങ്കിൽ iCloud ഐഡന്റിഫയറുകൾ എന്നിവ ഒരിക്കലും ഉൾപ്പെടുത്തില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनामिक वापर डेटा अडचणी शोधण्यात आणि वापर समजून घेण्यात मदत करतो. हा डेटा तुमच्या Apple खात्याशी कधीही जोडला जात नाही. कधीही समाविष्ट नसते: चेकलिस्टमधील आयटमची नावे, आयटमच्या टिपा, किंवा कोणतेही Apple अथवा iCloud ओळखकर्ते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data penggunaan tanpa nama membantu menyelesaikan masalah dan memahami penggunaan. Data tidak pernah dipautkan kepada Akaun Apple anda. Tidak disertakan: nama item senarai semak, nota item atau mana-mana pengecam Apple atau iCloud."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme bruksdata hjelper med feilsøking og å forstå bruken. Dataene knyttes aldri til Apple-kontoen din. Aldri inkludert: navn på punkter i sjekklister, notater eller Apple- og iCloud-identifikatorer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonieme gebruiksgegevens helpen bij het oplossen van problemen en het begrijpen van het gebruik. Gegevens worden nooit gekoppeld aan je Apple Account. Nooit inbegrepen: namen van checklistonderdelen, notities van onderdelen en Apple- of iCloud-identificaties."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ଡାଟା ସମସ୍ୟା ସମାଧାନ ଓ ବ୍ୟବହାର ବୁଝିବାରେ ସାହାଯ୍ୟ କରେ। ଏହି ଡାଟା କେବେ ଆପଣଙ୍କ Apple ଆକାଉଣ୍ଟ ସହ ଯୋଡ଼ାଯାଏ ନାହିଁ। ଏଥିରେ ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ନୋଟ୍, କିମ୍ବା କୌଣସି Apple ବା iCloud ପରିଚୟ କେବେ ରହେ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਸਮੱਸਿਆਵਾਂ ਲੱਭਣ ਅਤੇ ਵਰਤੋਂ ਨੂੰ ਸਮਝਣ ਵਿੱਚ ਮਦਦ ਕਰਦਾ ਹੈ। ਡਾਟਾ ਕਦੇ ਵੀ ਤੁਹਾਡੇ Apple ਖਾਤੇ ਨਾਲ ਨਹੀਂ ਜੋੜਿਆ ਜਾਂਦਾ। ਕਦੇ ਸ਼ਾਮਲ ਨਹੀਂ ਹੁੰਦੇ: ਚੈੱਕਲਿਸਟ ਆਈਟਮਾਂ ਦੇ ਨਾਮ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ ਕੋਈ ਵੀ Apple ਜਾਂ iCloud ਪਛਾਣ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimowe dane o użytkowaniu pomagają rozwiązywać problemy i zrozumieć, jak aplikacja jest używana. Dane nigdy nie są powiązane z Twoim kontem Apple. Nigdy nie obejmują nazw pozycji, notatek do pozycji ani żadnych identyfikatorów Apple czy iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de uso anônimos ajudam a resolver problemas e entender o uso. Os dados nunca são vinculados à sua Conta Apple. Nunca incluídos: nomes de itens do checklist, notas de itens ou qualquer identificador da Apple ou do iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de utilização anónimos ajudam a resolver problemas e a perceber a utilização. Os dados nunca são associados à sua Conta Apple. Nunca são incluídos: nomes de elementos, notas de elementos ou quaisquer identificadores Apple ou iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele anonime de utilizare ajută la remedierea problemelor și la înțelegerea modului de folosire. Datele nu sunt legate niciodată de Contul dumneavoastră Apple. Nu includ niciodată numele elementelor, notele elementelor sau identificatori Apple ori iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимные данные об использовании помогают находить неполадки и понимать, как используется приложение. Эти данные никогда не связываются с вашим аккаунтом Apple. Никогда не передаются: названия пунктов, заметки, идентификаторы Apple и iCloud."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymné údaje o používaní pomáhajú riešiť problémy a chápať, ako sa aplikácia používa. Údaje nie sú nikdy prepojené s vaším Apple účtom. Nikdy nezahŕňajú názvy položiek zoznamov, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimni podatki o uporabi pomagajo pri odpravljanju težav in razumevanju uporabe. Podatki niso nikoli povezani z vašim računom Apple. Nikoli niso vključeni: imena postavk kontrolnih seznamov, opombe postavk ter identifikatorji računa Apple ali iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyma användningsdata hjälper till att felsöka problem och förstå hur appen används. Data kopplas aldrig till ditt Apple-konto. Ingår aldrig: namn på checklistpunkter, anteckningar till punkter eller några Apple- eller iCloud-identifierare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அநாமதேயப் பயன்பாட்டுத் தரவு சிக்கல்களைக் கண்டறியவும் பயன்பாட்டைப் புரிந்துகொள்ளவும் உதவும். இந்தத் தரவு உங்கள் Apple கணக்குடன் ஒருபோதும் இணைக்கப்படாது. செக்லிஸ்ட் உருப்படிப் பெயர்கள், உருப்படிக் குறிப்புகள், Apple அல்லது iCloud அடையாளங்காட்டிகள் எதுவும் சேர்க்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనామక వినియోగ డేటా సమస్యలను పరిష్కరించడానికి, వినియోగాన్ని అర్థం చేసుకోవడానికి సహాయపడుతుంది. ఈ డేటా మీ Apple ఖాతాకు ఎప్పుడూ లింక్ చేయబడదు. చెక్‌లిస్ట్ అంశాల పేర్లు, అంశాల గమనికలు, లేదా ఏ Apple, iCloud ఐడెంటిఫైయర్‌లు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลการใช้งานแบบไม่ระบุตัวตนช่วยแก้ไขปัญหาและทำความเข้าใจการใช้งาน ข้อมูลจะไม่ถูกเชื่อมโยงกับบัญชี Apple ของคุณ และจะไม่รวมชื่อรายการในเช็กลิสต์ โน้ตของรายการ หรือตัวระบุของ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonim kullanım verileri, sorunları gidermeye ve kullanımı anlamaya yardımcı olur. Veriler hiçbir zaman Apple Hesabınızla ilişkilendirilmez. Asla dahil edilmeyenler: kontrol listesi ögelerinin adları, öge notları ve Apple ya da iCloud tanımlayıcıları."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонімні дані про використання допомагають виявляти помилки й розуміти, як користуються застосунком. Ці дані ніколи не пов’язуються з вашим обліковим записом Apple. Ніколи не надсилаються: назви пунктів, нотатки до них та будь-які ідентифікатори Apple чи iCloud."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گمنام استعمال کا ڈیٹا مسائل کا پتا لگانے اور استعمال کو سمجھنے میں مدد دیتا ہے۔ یہ ڈیٹا آپ کے Apple اکاؤنٹ سے کبھی نہیں جوڑا جاتا۔ کبھی شامل نہیں ہوتے: چیک لسٹ کے آئٹم کے نام، آئٹم کے نوٹس، یا Apple یا iCloud کی کوئی شناخت۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu sử dụng ẩn danh giúp khắc phục sự cố và hiểu cách ứng dụng được dùng. Dữ liệu không bao giờ được liên kết với Tài khoản Apple của bạn. Không bao giờ đưa vào: tên mục, ghi chú mục hoặc bất kỳ mã định danh Apple hay iCloud nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名使用数据有助于排查问题和了解使用情况。数据绝不会与你的 Apple 账户关联。绝不包含：清单项目名称、项目备注，以及任何 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名使用資料有助於排解問題並了解使用情形。資料絕不會與你的 Apple 帳號連結，也絕不包含檢查清單項目名稱、項目備註，或任何 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
