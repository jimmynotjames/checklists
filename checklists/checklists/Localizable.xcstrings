    "settings.icloud.footer.needsAttention" : {
      "comment" : "Footer under the iCloud section when the account is temporarily unavailable. 'Settings' here means the iOS Settings app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الإعدادات وأكّد حساب Apple لاستئناف المزامنة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক আবার শুরু করতে সেটিংস খুলে আপনার Apple অ্যাকাউন্ট নিশ্চিত করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre Configuració i confirma el teu Compte d'Apple per reprendre la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Nastavení a potvrďte svůj Apple účet, aby se synchronizace obnovila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Indstillinger, og bekræft din Apple-konto for at genoptage synkroniseringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen und bestätige deinen Apple Account, um die Synchronisierung fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τις Ρυθμίσεις και επιβεβαιώστε τον Λογαριασμό σας Apple για να συνεχιστεί ο συγχρονισμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and confirm your Apple Account to resume syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes y confirma tu Cuenta de Apple para reanudar la sincronización."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Configuración y confirma tu Cuenta de Apple para reanudar la sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Asetukset ja vahvista Apple-tilisi, niin synkronointi jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez les Réglages et confirmez votre compte Apple pour reprendre la synchronisation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez les Réglages et confirmez votre compte Apple pour reprendre la synchronisation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેટિંગ્સ ખોલો અને સિંક ફરી શરૂ કરવા તમારા Apple એકાઉન્ટની પુષ્ટિ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את הגדרות ואשרו את חשבון Apple כדי לחדש את הסנכרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक फिर से शुरू करने के लिए सेटिंग्ज़ खोलें और अपने Apple खाते की पुष्टि करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Postavke i potvrdite svoj Apple račun kako bi se sinkronizacija nastavila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a Beállításokat, és erősítse meg Apple-fiókját a szinkronizálás folytatásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Pengaturan dan konfirmasi Akun Apple Anda untuk melanjutkan sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Impostazioni e conferma il tuo Account Apple per riprendere la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を開いてAppleアカウントを確認すると、同期が再開されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಿಂಕ್ ಮುಂದುವರಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆದು ನಿಮ್ಮ Apple ಖಾತೆಯನ್ನು ದೃಢೀಕರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 열고 Apple 계정을 확인하면 동기화가 다시 시작돼요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സമന്വയം തുടരാൻ ക്രമീകരണം തുറന്ന് നിങ്ങളുടെ Apple അക്കൗണ്ട് സ്ഥിരീകരിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक पुन्हा सुरू करण्यासाठी सेटिंग्ज उघडून तुमच्या Apple खात्याची खात्री करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Seting dan sahkan Akaun Apple anda untuk menyambung semula penyelarasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Innstillinger og bekreft Apple-kontoen din for å fortsette synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen en bevestig je Apple Account om weer te synchroniseren."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସିଙ୍କ ପୁଣି ଆରମ୍ଭ କରିବାକୁ ସେଟିଂସ୍ ଖୋଲି ଆପଣଙ୍କ Apple ଆକାଉଣ୍ଟ ନିଶ୍ଚିତ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿੰਕ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹ ਕੇ ਆਪਣੇ Apple ਖਾਤੇ ਦੀ ਪੁਸ਼ਟੀ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Ustawienia i potwierdź swoje konto Apple, aby wznowić synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Ajustes e confirme sua Conta Apple para retomar a sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra as Definições e confirme a sua Conta Apple para retomar a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschideți Configurări și confirmați Contul Apple pentru a relua sincronizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «Настройки» и подтвердите аккаунт Apple, чтобы возобновить синхронизацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorte Nastavenia a potvrďte svoj Apple účet, aby sa synchronizácia obnovila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprite nastavitve in potrdite svoj račun Apple, da se sinhronizacija nadaljuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Inställningar och bekräfta ditt Apple-konto för att återuppta synkroniseringen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒத்திசைவைத் தொடர, அமைப்புகளைத் திறந்து உங்கள் Apple கணக்கை உறுதிசெய்யுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సింక్ తిరిగి కొనసాగడానికి సెట్టింగ్‌లు తెరిచి మీ Apple ఖాతాను నిర్ధారించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดการตั้งค่าและยืนยันบัญชี Apple ของคุณเพื่อซิงค์ต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
