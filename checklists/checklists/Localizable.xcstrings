          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی انٹرنیٹ کنکشن چیک کریں۔ آپ کی چیک لسٹیں اس ڈیوائس پر محفوظ ہیں۔"
