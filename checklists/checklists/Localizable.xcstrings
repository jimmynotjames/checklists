    "settings.analytics.footer" : {
      "comment" : "Footer under the analytics section explaining what usage data is and is not collected.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد بيانات الاستخدام المجهولة على حل المشاكل وفهم الاستخدام. لا يتم ربط البيانات بحسابك في Apple أبدًا. لا يتم تضمين: أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو أي معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেনামি ব্যবহারের ডেটা সমস্যা সমাধান এবং ব্যবহার বোঝা সাহায্য করে। ডেটা কখনও আপনার Apple অ্যাকাউন্টের সাথে যুক্ত নয়। কখনও অন্তর্ভুক্ত নয়: চেকলিস্ট আইটেম নাম, আইটেম নোট বা যেকোনো Apple বা iCloud সনাক্তকারী।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades d'ús anònimes ajuden a solucionar problemes i entendre l'ús. Les dades mai no es vinculen al teu compte d'Apple. Mai no s'inclouen: noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymní data o používání pomáhají najít problémy a pochopit, jak se aplikace používá. Data nejsou nikdy propojena s tvým účtem Apple. Nikdy se neposílají: jména položek kontrolního seznamu, poznámky k položkám ani identifikátory Apple nebo iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme brugsdata hjælper med fejlfinding og forståelse af brugen. Data knyttes aldrig til din Apple-konto. Aldrig inkluderet: navn på tjekliste-elementer, element-noter eller Apple- eller iCloud-identifikatorer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsdaten helfen bei der Fehlerbehebung und dem Verständnis der Nutzung. Daten sind niemals mit deinem Apple-Account verknüpft. Niemals enthalten: Checklisten-Eintrags-Namen, Notizen oder Apple- oder iCloud-Kennungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ανώνυμα δεδομένα χρήσης βοηθούν στην αντιμετώπιση προβλημάτων και στην κατανόηση της χρήσης. Τα δεδομένα δεν συνδέονται ποτέ με τον λογαριασμό σας Apple. Δεν περιλαμβάνονται ποτέ: ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage data helps troubleshoot issues and understand usage. Data is never linked to your Apple Account. Never included: checklist item names, item notes, or any Apple or iCloud identifiers."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
