        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ایپ کو ایسے شروع کرے گا جیسے نئی انسٹال کی گئی ہو۔ اس ڈیوائس پر موجود تمام ڈیٹا ضائع ہو جائے گا۔ اسے واپس نہیں کیا جا سکتا۔"
