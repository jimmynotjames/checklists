          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre l'app comme si elle venait d'être installée. Toutes les données de cet appareil seront perdues."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એપ્લિકેશનને નવી ઇન્સ્ટૉલ કર્યા જેવી શરૂ કરે છે. આ ડિવાઇસ પરનો બધો ડેટા ગુમાવાશે."
