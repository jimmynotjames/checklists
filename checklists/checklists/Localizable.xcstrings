        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو ایسے شروع کرتا ہے جیسے یہ نئے سرے سے انسٹال ہوا ہو۔ اس ڈیوائس پر کوئی بھی ڈیٹا کھو جائے گا۔"
