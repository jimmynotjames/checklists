          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Inställningar och bekräfta ditt Apple-konto för att återuppta synkroniseringen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அமைப்புகளைத் திறந்து உங்கள் Apple கணக்கை உறுதிப்படுத்தி ஒத்திசைவை மீண்டும் தொடங்கவும்."
