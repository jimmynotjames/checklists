        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಚೆಕ್‌ಲಿಸ್ಟ್‌ಗಳನ್ನು ಸಾಧನಗಳಾದ್ಯಂತ ಸಿಂಕ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 iCloud에 로그인하면 여러 기기에서 체크리스트를 동기화할 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ചെക്ക്‌ലിസ്റ്റുകൾ എല്ലാ ഉപകരണങ്ങളിലും സിങ്ക് ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ iCloud ലേക്ക് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमची चेकलिस्ट्स सर्व डिव्हाइसेसमध्ये सिंक करण्यासाठी सेटिंग्जमध्ये iCloud मध्ये साइन इन करा।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk ke iCloud dalam Tetapan untuk menyegerakkan senarai semak anda merentas peranti."
