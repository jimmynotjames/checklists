    "settings.icloud.footer.paused" : {
      "comment" : "Footer under the iCloud section when sync is paused for this launch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ قوائم التحقق الخاصة بك على هذا الجهاز فقط. أعد تشغيل التطبيق لإعادة محاولة مزامنة iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চেকলিস্ট শুধুমাত্র এই ডিভাইসে সংরক্ষিত। iCloud সিঙ্ক পুনরায় চেষ্টা করতে অ্যাপ পুনরায় চালু করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves llistes de comprovació es guarden només en aquest dispositiu. Reinicia l'aplicació per reintentar la sincronització de l'iCloud."
