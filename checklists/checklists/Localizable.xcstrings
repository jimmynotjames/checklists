        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஏதோ தவறு நடந்துவிட்டது. செயலியை மீண்டும் தொடங்கிப் பார்க்கலாமா? சேமிப்பகம் நிறைந்துவிட்டதா என்றும் சரிபார்க்கலாமா?"
          }
        },
        "te" : {
