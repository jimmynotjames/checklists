    "checklist.menu.duplicateChecklist" : {
      "comment" : "Overflow-menu entry on an existing checklist's detail screen that makes a copy of it. Not destructive and not confirmed: it opens the copy straight away. It sits above the Delete Checklist entry, so the two must not read alike.",
