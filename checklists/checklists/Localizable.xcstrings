        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തീർച്ചയാണോ? ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला खात्री आहे का? ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda pasti? Tindakan ini tidak boleh dibuat asal."
