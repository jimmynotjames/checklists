    "containerFailure.action.startOver.hint" : {
      "comment" : "VoiceOver hint for the Start over fresh button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التطبيق كما لو كان مثبتًا حديثًا. ستفقد أي بيانات على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি নতুন ইনস্টল করার মতো শুরু হবে। এই ডিভাইসের সব ডেটা হারিয়ে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia l'app com si l'acabessis d'instal·lar. Es perdran totes les dades d'aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí aplikaci jako při nové instalaci. Všechna data v tomto zařízení budou ztracena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starter appen, som var den nyinstalleret. Alle data på denne enhed går tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet die App, als wäre sie neu installiert. Alle Daten auf diesem Gerät gehen verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινά την εφαρμογή σαν να έχει μόλις εγκατασταθεί. Όλα τα δεδομένα σε αυτή τη συσκευή θα χαθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts the app as if it were newly installed. Any data on this device will be lost."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts the app as if it were newly installed. Any data on this device will be lost."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts the app as if it were newly installed. Any data on this device will be lost."
