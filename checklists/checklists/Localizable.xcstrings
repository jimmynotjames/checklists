        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app kan anonieme gebruiksgegevens verzenden om problemen op te lossen en het gebruik te begrijpen. Gegevens zijn nooit gekoppeld aan je Apple Account. Nooit opgenomen: checklistnamen, itemnotities of Apple- of iCloud-identifiers. Je kunt dit op elk moment in Instellingen wijzigen."
          }
