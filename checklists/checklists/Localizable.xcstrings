        }
      }
    },
    "settings.icloud.footer.storageFull" : {
      "comment" : "Footer under the iCloud section when iCloud storage is full. 'Settings' here means the iOS Settings app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّر مساحة على iCloud في الإعدادات لاستئناف المزامنة. قوائمك محفوظة على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংসে iCloud স্টোরেজ খালি করুন সিঙ্ক পুনরায় শুরু করতে। আপনার চেকলিস্ট এই ডিভাইসে সংরক্ষিত।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allibera espai a l'iCloud a Configuració per reprendre la sincronització. Les teves llistes es desen en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolněte místo v iCloudu v Nastavení, aby pokračovala synchronizace. Vaše seznamy jsou uloženy na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigør iCloud-lager i Indstillinger for at genoptage synkroniseringen. Dine tjeklister gemmes på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Speicherplatz in iCloud über Einstellungen frei, um die Synchronisierung fortzusetzen. Deine Checklisten werden auf diesem Gerät gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελευθερώστε χώρο iCloud στις Ρυθμίσεις για να συνεχίσετε. Οι λίστες ελέγχου αποθηκεύονται σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free up iCloud storage in Settings to resume syncing. Your checklists are saved on this device."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free up iCloud storage in Settings to resume syncing. Your checklists are saved on this device."
          }
        },
