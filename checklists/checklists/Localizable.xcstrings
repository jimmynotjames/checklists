    "sample.preTrip.item9.notes" : {
      "comment" : "Note under the heater item. Adapt to the local climate; a warm-climate locale may replace the freezing-pipes concern.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اضبط المكيف على درجة مرتفعة وأغلق الستائر لتخفيف الحر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গিজারের সুইচও বন্ধ আছে কি না দেখে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O deixar la calefacció al mínim si marxes a l'hivern."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo nastavit nízkou teplotu, ať nezamrznou trubky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller sæt en minimumstemperatur, så rørene ikke fryser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder auf Frostschutz stellen, damit keine Rohre einfrieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τον χειμώνα άσε 15°C για να μην πιάσει υγρασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or set minimum temp to prevent freezing pipes."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the blinds as well to keep the heat out."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or set the thermostat low to keep pipes from freezing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or leave it on frost protection so the pipes don't freeze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O déjala al mínimo si hace mucho frío fuera."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O déjalo en temperatura alta para que gaste menos luz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai jätä peruslämpö päälle, etteivät putket jäädy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou laisse le mode hors-gel pour protéger les tuyaux."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou garder un minimum pour éviter que les tuyaux gèlent."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક રૂમના પંખા, લાઇટ અને ગીઝરના સ્વિચ પણ તપાસી લો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכבות גם את הדוד, אין טעם לחמם מים לריק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गीज़र और मोटर का स्विच भी बंद करना न भूलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili postavi minimalnu temperaturu da cijevi ne puknu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy fagyvédelemre állítani, hogy ne fagyjanak be a csövek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka sedikit ventilasi supaya rumah tidak lembap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure imposta il minimo per non far gelare i tubi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寒い時期は、凍結防止のため水道の水抜きをしておきます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಗೀಸರ್ ಸ್ವಿಚ್ ಆಫ್ ಮಾಡಲು ಮರೆಯಬೇಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "겨울이면 보일러를 외출 모드로 두면 수도관 동파를 막을 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഫ്രിഡ്ജ് മാത്രം ഓണാക്കി വെച്ചാൽ മതി."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ्रिज सोडून बाकी सगळे स्विच बंद करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau biarkan kipas ekzos hidup supaya rumah tak lembap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller sett minimumstemperatur så ikke rørene fryser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of op de vorstvrije stand tegen bevroren leidingen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗିଜର ଓ ଇନଭର୍ଟରର ସୁଇଚ୍ ମଧ୍ୟ ବନ୍ଦ କରି ଦିଅନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗੀਜ਼ਰ ਤੇ ਪੱਖੇ ਵੀ ਬੰਦ ਕਰ ਦਿਓ, ਬਿੱਲ ਬਚੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albo ustaw minimalną temperaturę, żeby rury nie zamarzły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira também os ventiladores e o ar dos quartos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou deixa no mínimo para a casa não ganhar humidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau lasă temperatura minimă, ca să nu înghețe țevile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или оставь минимум, чтобы не разморозить трубы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alebo nastaviť minimálnu teplotu, nech nezamrznú rúry."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali nastavi minimalno temperaturo, da cevi ne zmrznejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller ställ in lägsta värmen så rören inte fryser."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கீஸரையும் அணைக்கவும்; ஃப்ரிட்ஜை மட்டும் ஓடவிடலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఫ్రిజ్, ఇన్వర్టర్ మాత్రం ఆన్‌లోనే ఉంచండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าไปหลายวัน เปิดช่องระบายอากาศไว้บ้าง กันบ้านอับชื้นและขึ้นรา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da kombiyi donma korumasına al."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або виставити мінімальну температуру, щоб не замерзли труби."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سردیوں میں ہیٹر اور گیزر بھی بند کر دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhớ tắt cả bình nóng lạnh, chỉ để tủ lạnh chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或留最低温度，防止水管冻裂。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長時間不在家，可設定除濕機定時，避免發霉。"
          }
        }
      }
    },
