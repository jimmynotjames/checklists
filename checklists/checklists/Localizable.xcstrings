    "settings.analytics.toggle.hint" : {
      "comment" : "VoiceOver hint for the analytics opt-in toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح للتطبيق بإرسال بيانات استخدام مجهولة لمساعدة التطبيق على التحسّن. لا يتم تضمين أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ উন্নত করতে সাহায্য করতে অ্যাপটিকে বেনামি ব্যবহারের ডেটা পাঠানোর অনুমতি দেয়। চেকলিস্ট আইটেমের নাম, আইটেম নোট, বা Apple বা iCloud পরিচয় কখনও অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que l'aplicació enviï dades d'ús anònimes per ajudar a millorar l'aplicació. Les dades mai inclouen noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní aplikaci odesílat anonymní data o používání, která pomáhají vylepšovat aplikaci. Nikdy nejsou zahrnuty názvy položek kontrolních seznamů, poznámky k položkám ani identifikátory Apple nebo iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader appen sende anonyme brugsdata, så den kan blive bedre. Navne på tjeklistepunkter, noter til punkter og Apple- eller iCloud-id'er er aldrig med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt der App, anonyme Nutzungsdaten zu senden, damit sie besser wird. Namen und Notizen von Einträgen sowie Apple- oder iCloud-Kennungen werden nie übermittelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στην εφαρμογή να στέλνει ανώνυμα δεδομένα χρήσης για να βοηθήσει στη βελτίωσή της. Δεν περιλαμβάνονται ποτέ ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
