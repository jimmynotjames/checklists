    "loading.cloudSyncNote" : {
      "comment" : "Footnote under the migration message when the migrated data will start syncing through iCloud.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم الآن مزامنة قوائم التحقق بين أجهزتك عبر iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চেকলিস্ট এখন iCloud-এর মাধ্যমে আপনার সব ডিভাইসে সিঙ্ক হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara les teves llistes se sincronitzaran entre els teus dispositius amb iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše seznamy se teď budou synchronizovat mezi zařízeními přes iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine tjeklister synkroniseres nu mellem dine enheder via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Checklisten werden jetzt über iCloud auf deinen Geräten synchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λίστες ελέγχου σας θα συγχρονίζονται πλέον στις συσκευές σας μέσω iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklists will now sync across your devices through iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas ahora se sincronizarán entre tus dispositivos mediante iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas ahora se sincronizarán entre tus dispositivos mediante iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistuslistasi synkronoidaan nyt laitteidesi välillä iCloudin kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos listes se synchroniseront désormais sur vos appareils via iCloud."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos listes de vérification seront maintenant synchronisées sur vos appareils par iCloud."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ચેકલિસ્ટ હવે iCloud દ્વારા તમારા ડિવાઇસ પર સિંક થશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימות שלך יסונכרנו מעכשיו בין המכשירים דרך iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी चेकलिस्ट अब iCloud के ज़रिए आपके सभी डिवाइस पर सिंक होंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši će se popisi sada sinkronizirati na svim vašim uređajima putem iClouda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listái mostantól az iCloudon keresztül szinkronizálódnak az eszközei között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar periksa Anda kini akan disinkronkan di semua perangkat Anda melalui iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da ora le tue checklist si sincronizzano tra i tuoi dispositivi tramite iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックリストは、iCloudを通じてデバイス間で同期されるようになります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಚೆಕ್‌ಲಿಸ್ಟ್‌ಗಳು ಇನ್ನು ಮುಂದೆ iCloud ಮೂಲಕ ನಿಮ್ಮ ಸಾಧನಗಳಾದ್ಯಂತ ಸಿಂಕ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 체크리스트가 iCloud를 통해 기기 간에 동기화돼요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ചെക്ക്‌ലിസ്റ്റുകൾ ഇനി iCloud വഴി ഉപകരണങ്ങളിലുടനീളം സമന്വയിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
