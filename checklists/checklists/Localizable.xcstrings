    "settings.analytics.toggle.hint" : {
      "comment" : "VoiceOver hint for the analytics opt-in toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح للتطبيق بإرسال بيانات استخدام مجهولة الهوية للمساعدة في تحسينه. لا يتم تضمين أسماء عناصر القوائم أو ملاحظاتها أو أي معرّفات من Apple أو iCloud إطلاقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ উন্নত করতে অ্যাপকে বেনামী ব্যবহারের ডেটা পাঠাতে দেয়। চেকলিস্টের আইটেমের নাম, আইটেমের নোট, বা Apple ও iCloud-এর কোনো শনাক্তকারী কখনও অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que l'app enviï dades d'ús anònimes per ajudar a millorar-la. Mai s'hi inclouen noms d'elements, notes dels elements ni identificadors d'Apple o d'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní aplikaci odesílat anonymní data o používání, která pomáhají aplikaci zlepšovat. Nikdy nezahrnují názvy položek seznamů, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader appen sende anonyme brugsdata, så den kan blive bedre. Navne og noter på punkter samt Apple- og iCloud-id'er medtages aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt der App, anonyme Nutzungsdaten zu senden, um sie zu verbessern. Namen und Notizen von Einträgen sowie Apple- oder iCloud-Kennungen sind nie enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στην εφαρμογή να στέλνει ανώνυμα δεδομένα χρήσης για τη βελτίωσή της. Δεν περιλαμβάνονται ποτέ ονόματα ή σημειώσεις στοιχείων ούτε αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la app envíe datos de uso anónimos para ayudar a mejorarla. Nunca se incluyen nombres ni notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la app envíe datos de uso anónimos para ayudar a mejorarla. Nunca se incluyen nombres de elementos, notas de elementos ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii sovelluksen lähettää anonyymejä käyttötietoja sovelluksen parantamiseksi. Mukaan ei koskaan oteta tarkistuslistan kohtien nimiä, kohtien muistiinpanoja eikä Apple- tai iCloud-tunnisteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l'app à envoyer des données d'utilisation anonymes pour aider à l'améliorer. Aucun nom ni note d'élément, ni identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à l'app d'envoyer des données d'utilisation anonymes pour aider à l'améliorer. Aucun nom d'élément, aucune note d'élément ni aucun identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એપ્લિકેશન સુધારવામાં મદદ માટે અનામી વપરાશ ડેટા મોકલવાની મંજૂરી આપે છે. ચેકલિસ્ટ આઇટમના નામ, આઇટમની નોંધો કે Apple અથવા iCloud ઓળખકર્તા ક્યારેય સામેલ કરાતા નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לאפליקציה לשלוח נתוני שימוש אנונימיים לשיפור האפליקציה. לעולם לא נכללים שמות של פריטים, הערות לפריטים או מזהים של Apple או iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को बेहतर बनाने में मदद के लिए अनाम उपयोग डेटा भेजने देता है। चेकलिस्ट आइटम के नाम, आइटम के नोट्स, या Apple या iCloud आइडेंटिफ़ायर कभी शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopušta aplikaciji slanje anonimnih podataka o korištenju radi poboljšanja aplikacije. Nikada se ne uključuju nazivi stavki popisa, bilješke stavki ni Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezi, hogy az app anonim használati adatokat küldjön a fejlesztéséhez. Listaelemek nevei, elemjegyzetek, valamint Apple- és iCloud-azonosítók soha nem kerülnek bele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengizinkan aplikasi mengirim data penggunaan anonim untuk membantu menyempurnakan aplikasi. Nama item daftar periksa, catatan item, serta pengenal Apple atau iCloud tidak pernah disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente all'app di inviare dati di utilizzo anonimi per aiutare a migliorarla. Non vengono mai inclusi i nomi delle voci, le note delle voci né identificatori Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの改善に役立てるため、匿名の使用状況データの送信を許可します。チェックリストの項目名、項目のメモ、AppleやiCloudの識別子は一切含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ್ಯಪ್ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡುವ ಅನಾಮಧೇಯ ಬಳಕೆಯ ಡೇಟಾವನ್ನು ಕಳುಹಿಸಲು ಆ್ಯಪ್‌ಗೆ ಅನುಮತಿಸುತ್ತದೆ. ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಐಟಂ ಟಿಪ್ಪಣಿಗಳು, ಅಥವಾ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳನ್ನು ಎಂದಿಗೂ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 개선을 위해 익명 사용 데이터를 보내도록 허용해요. 체크리스트 항목 이름, 항목 메모, Apple 또는 iCloud 식별자는 절대 포함되지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആപ്പ് മെച്ചപ്പെടുത്താൻ അജ്ഞാത ഉപയോഗ ഡാറ്റ അയയ്ക്കാൻ അനുവദിക്കുന്നു. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകളോ ഇനങ്ങളുടെ കുറിപ്പുകളോ Apple, iCloud ഐഡന്റിഫയറുകളോ ഒരിക്കലും ഉൾപ്പെടുത്തില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अॅप सुधारण्यासाठी अॅपला अनामिक वापर डेटा पाठवू देते. चेकलिस्टमधील आयटमची नावे, आयटमच्या टिपा किंवा Apple अथवा iCloud ओळखकर्ते कधीही समाविष्ट केले जात नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan app menghantar data penggunaan tanpa nama untuk membantu menambah baik app. Tiada nama item senarai semak, nota item atau pengecam Apple atau iCloud disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar appen sende anonyme bruksdata for å bidra til å forbedre appen. Navn på punkter, notater og Apple- eller iCloud-identifikatorer blir aldri inkludert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat toe dat de app anonieme gebruiksgegevens verstuurt om de app te verbeteren. Namen en notities van onderdelen en Apple- of iCloud-identificaties worden nooit meegestuurd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପ୍‌କୁ ଉନ୍ନତ କରିବାରେ ସାହାଯ୍ୟ ପାଇଁ ଆପ୍‌କୁ ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ଡାଟା ପଠାଇବାକୁ ଅନୁମତି ଦିଏ। ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ନୋଟ୍ କିମ୍ବା Apple ବା iCloud ପରିଚୟ କେବେ ଅନ୍ତର୍ଭୁକ୍ତ ହୁଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਇਸਨੂੰ ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਭੇਜਣ ਦਿੰਦਾ ਹੈ। ਚੈੱਕਲਿਸਟ ਆਈਟਮਾਂ ਦੇ ਨਾਮ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ Apple ਜਾਂ iCloud ਦੀਆਂ ਪਛਾਣਾਂ ਕਦੇ ਸ਼ਾਮਲ ਨਹੀਂ ਹੁੰਦੀਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala aplikacji wysyłać anonimowe dane o użytkowaniu, które pomagają ulepszać aplikację. Nigdy nie obejmują nazw pozycji, notatek do pozycji ani identyfikatorów Apple czy iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o app envie dados de uso anônimos para ajudar a melhorar o app. Nunca são incluídos nomes de itens do checklist, notas de itens ou identificadores da Apple ou do iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que a app envie dados de utilização anónimos para ajudar a melhorá-la. Nunca são incluídos nomes nem notas de elementos, nem identificadores Apple ou iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite aplicației să trimită date anonime de utilizare, pentru a ajuta la îmbunătățirea ei. Nu includ niciodată numele sau notele elementelor, nici identificatori Apple sau iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешает приложению отправлять анонимные данные об использовании, чтобы улучшать его. Названия пунктов, заметки и идентификаторы Apple или iCloud никогда не передаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolí aplikácii odosielať anonymné údaje o používaní, ktoré pomáhajú zlepšovať aplikáciu. Nikdy nezahŕňajú názvy položiek zoznamov, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaciji dovoli pošiljanje anonimnih podatkov o uporabi, ki pomagajo izboljšati aplikacijo. Imena postavk, opombe postavk ter identifikatorji računa Apple ali iCloud niso nikoli vključeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter appen skicka anonyma användningsdata för att förbättra den. Namn på checklistpunkter, anteckningar till punkter och Apple- eller iCloud-identifierare ingår aldrig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப்ஸை மேம்படுத்த உதவ, அநாமதேயப் பயன்பாட்டுத் தரவை அனுப்ப ஆப்ஸை அனுமதிக்கும். செக்லிஸ்ட் உருப்படிப் பெயர்கள், உருப்படிக் குறிப்புகள், Apple அல்லது iCloud அடையாளங்காட்டிகள் எதுவும் சேர்க்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్‌ను మెరుగుపరచడంలో సహాయపడేందుకు అనామక వినియోగ డేటాను పంపడానికి యాప్‌ను అనుమతిస్తుంది. చెక్‌లిస్ట్ అంశాల పేర్లు, అంశాల గమనికలు, లేదా Apple, iCloud ఐడెంటిఫైయర్‌లు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้แอปส่งข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุงแอป ข้อมูลนี้ไม่รวมชื่อรายการในเช็กลิสต์ โน้ตของรายการ หรือตัวระบุของ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın gelişmesine yardımcı olmak için anonim kullanım verileri göndermesine izin verir. Kontrol listesi ögelerinin adları, öge notları veya Apple ya da iCloud tanımlayıcıları asla dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє застосунку надсилати анонімні дані про використання, щоб покращувати його. Назви пунктів, нотатки до них, а також ідентифікатори Apple чи iCloud ніколи не надсилаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو بہتر بنانے کے لیے اسے گمنام استعمال کا ڈیٹا بھیجنے کی اجازت دیتا ہے۔ چیک لسٹ کے آئٹم کے نام، آئٹم کے نوٹس، یا Apple یا iCloud کی کوئی شناخت کبھی شامل نہیں کی جاتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép ứng dụng gửi dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Tên mục, ghi chú mục hoặc mã định danh Apple và iCloud không bao giờ được đưa vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 App 发送匿名使用数据，帮助改进 App。绝不包含清单项目名称、项目备注，以及 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 App 傳送匿名使用資料，協助改善 App。絕不會包含檢查清單項目名稱、項目備註，或 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
