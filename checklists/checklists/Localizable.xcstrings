    "consent.action.accept.hint" : {
      "comment" : "VoiceOver hint for the accept button on the analytics consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفعّل مشاركة بيانات الاستخدام المجهولة الهوية للمساعدة في تحسين التطبيق. لا يتم تضمين أسماء عناصر القوائم أو ملاحظاتها أو أي معرّفات من Apple أو iCloud إطلاقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ উন্নত করতে বেনামী ব্যবহারের ডেটা চালু করে। চেকলিস্টের আইটেমের নাম, আইটেমের নোট, বা Apple ও iCloud-এর কোনো শনাক্তকারী কখনও অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa les dades d'ús anònimes per ajudar a millorar l'app. Mai s'hi inclouen noms d'elements, notes dels elements ni identificadors d'Apple o d'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne anonymní data o používání, která pomáhají aplikaci zlepšovat. Nikdy nezahrnují názvy položek seznamů, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår anonyme brugsdata til, så appen kan blive bedre. Navne og noter på punkter samt Apple- og iCloud-id'er medtages aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert anonyme Nutzungsdaten, um die App zu verbessern. Namen und Notizen von Einträgen sowie Apple- oder iCloud-Kennungen sind nie enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί τα ανώνυμα δεδομένα χρήσης για τη βελτίωση της εφαρμογής. Δεν περιλαμβάνονται ποτέ ονόματα ή σημειώσεις στοιχείων ούτε αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa los datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres ni notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa los datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos, notas de elementos ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottaa anonyymit käyttötiedot käyttöön sovelluksen parantamiseksi. Mukaan ei koskaan oteta tarkistuslistan kohtien nimiä, kohtien muistiinpanoja eikä Apple- tai iCloud-tunnisteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les données d'utilisation anonymes pour aider à améliorer l'app. Aucun nom ni note d'élément, ni identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les données d'utilisation anonymes pour aider à améliorer l'app. Aucun nom d'élément, aucune note d'élément ni aucun identifiant Apple ou iCloud n'est jamais inclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એપ્લિકેશન સુધારવામાં મદદ માટે અનામી વપરાશ ડેટા ચાલુ કરે છે. ચેકલિસ્ટ આઇટમના નામ, આઇટમની નોંધો કે Apple અથવા iCloud ઓળખકર્તા ક્યારેય સામેલ કરાતા નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל שליחה של נתוני שימוש אנונימיים לשיפור האפליקציה. לעולם לא נכללים שמות של פריטים, הערות לפריטים או מזהים של Apple או iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को बेहतर बनाने में मदद के लिए अनाम उपयोग डेटा चालू करता है। चेकलिस्ट आइटम के नाम, आइटम के नोट्स, या Apple या iCloud आइडेंटिफ़ायर कभी शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključuje anonimne podatke o korištenju radi poboljšanja aplikacije. Nikada se ne uključuju nazivi stavki popisa, bilješke stavki ni Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsolja az anonim használati adatok küldését az app fejlesztéséhez. Listaelemek nevei, elemjegyzetek, valamint Apple- és iCloud-azonosítók soha nem kerülnek bele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan data penggunaan anonim untuk membantu menyempurnakan aplikasi. Nama item daftar periksa, catatan item, serta pengenal Apple atau iCloud tidak pernah disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva i dati di utilizzo anonimi per aiutare a migliorare l'app. Non vengono mai inclusi i nomi delle voci, le note delle voci né identificatori Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名の使用状況データをオンにして、アプリの改善に役立てます。チェックリストの項目名、項目のメモ、AppleやiCloudの識別子は一切含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ್ಯಪ್ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡುವ ಅನಾಮಧೇಯ ಬಳಕೆಯ ಡೇಟಾವನ್ನು ಆನ್ ಮಾಡುತ್ತದೆ. ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಐಟಂ ಟಿಪ್ಪಣಿಗಳು, ಅಥವಾ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳನ್ನು ಎಂದಿಗೂ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 개선에 도움이 되도록 익명 사용 데이터를 켜요. 체크리스트 항목 이름, 항목 메모, Apple 또는 iCloud 식별자는 절대 포함되지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആപ്പ് മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്ന അജ്ഞാത ഉപയോഗ ഡാറ്റ ഓണാക്കുന്നു. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകളോ ഇനങ്ങളുടെ കുറിപ്പുകളോ Apple, iCloud ഐഡന്റിഫയറുകളോ ഒരിക്കലും ഉൾപ്പെടുത്തില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अॅप सुधारण्यासाठी अनामिक वापर डेटा सुरू करते. चेकलिस्टमधील आयटमची नावे, आयटमच्या टिपा किंवा Apple अथवा iCloud ओळखकर्ते कधीही समाविष्ट केले जात नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghidupkan data penggunaan tanpa nama untuk membantu menambah baik app. Tiada nama item senarai semak, nota item atau pengecam Apple atau iCloud disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår på anonyme bruksdata for å bidra til å forbedre appen. Navn på punkter, notater og Apple- eller iCloud-identifikatorer blir aldri inkludert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt anonieme gebruiksgegevens in om de app te verbeteren. Namen en notities van onderdelen en Apple- of iCloud-identificaties worden nooit meegestuurd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପ୍‌କୁ ଉନ୍ନତ କରିବାରେ ସାହାଯ୍ୟ ପାଇଁ ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ଡାଟା ଚାଲୁ କରେ। ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ନୋଟ୍ କିମ୍ବା Apple ବା iCloud ପରିଚୟ କେବେ ଅନ୍ତର୍ଭୁକ୍ତ ହୁଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਚਾਲੂ ਕਰਦਾ ਹੈ। ਚੈੱਕਲਿਸਟ ਆਈਟਮਾਂ ਦੇ ਨਾਮ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ Apple ਜਾਂ iCloud ਦੀਆਂ ਪਛਾਣਾਂ ਕਦੇ ਸ਼ਾਮਲ ਨਹੀਂ ਹੁੰਦੀਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza anonimowe dane o użytkowaniu, które pomagają ulepszać aplikację. Nigdy nie obejmują nazw pozycji, notatek do pozycji ani identyfikatorów Apple czy iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa os dados de uso anônimos para ajudar a melhorar o app. Nunca são incluídos nomes de itens do checklist, notas de itens ou identificadores da Apple ou do iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa os dados de utilização anónimos para ajudar a melhorar a app. Nunca são incluídos nomes nem notas de elementos, nem identificadores Apple ou iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează datele anonime de utilizare, pentru a ajuta la îmbunătățirea aplicației. Nu includ niciodată numele sau notele elementelor, nici identificatori Apple sau iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает отправку анонимных данных об использовании, чтобы улучшать приложение. Названия пунктов, заметки и идентификаторы Apple или iCloud никогда не передаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne anonymné údaje o používaní, ktoré pomáhajú zlepšovať aplikáciu. Nikdy nezahŕňajú názvy položiek zoznamov, poznámky k položkám ani identifikátory Apple či iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopi anonimne podatke o uporabi, ki pomagajo izboljšati aplikacijo. Imena postavk, opombe postavk ter identifikatorji računa Apple ali iCloud niso nikoli vključeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår på anonyma användningsdata för att förbättra appen. Namn på checklistpunkter, anteckningar till punkter och Apple- eller iCloud-identifierare ingår aldrig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப்ஸை மேம்படுத்த உதவ, அநாமதேயப் பயன்பாட்டுத் தரவை இயக்கும். செக்லிஸ்ட் உருப்படிப் பெயர்கள், உருப்படிக் குறிப்புகள், Apple அல்லது iCloud அடையாளங்காட்டிகள் எதுவும் சேர்க்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్‌ను మెరుగుపరచడంలో సహాయపడేందుకు అనామక వినియోగ డేటాను ఆన్ చేస్తుంది. చెక్‌లిస్ట్ అంశాల పేర్లు, అంశాల గమనికలు, లేదా Apple, iCloud ఐడెంటిఫైయర్‌లు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดการใช้ข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุงแอป ข้อมูลนี้ไม่รวมชื่อรายการในเช็กลิสต์ โน้ตของรายการ หรือตัวระบุของ Apple หรือ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın gelişmesine yardımcı olmak için anonim kullanım verilerini açar. Kontrol listesi ögelerinin adları, öge notları veya Apple ya da iCloud tanımlayıcıları asla dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вмикає надсилання анонімних даних про використання, щоб покращувати застосунок. Назви пунктів, нотатки до них, а також ідентифікатори Apple чи iCloud ніколи не надсилаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو بہتر بنانے کے لیے گمنام استعمال کا ڈیٹا آن کرتا ہے۔ چیک لسٹ کے آئٹم کے نام، آئٹم کے نوٹس، یا Apple یا iCloud کی کوئی شناخت کبھی شامل نہیں کی جاتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Tên mục, ghi chú mục hoặc mã định danh Apple và iCloud không bao giờ được đưa vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启匿名使用数据，帮助改进 App。绝不包含清单项目名称、项目备注，以及 Apple 或 iCloud 标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟匿名使用資料，協助改善 App。絕不會包含檢查清單項目名稱、項目備註，或 Apple 或 iCloud 識別碼。"
          }
        }
      }
    },
