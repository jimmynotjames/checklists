    "checklist.confirm.deleteCheckedItems.message" : {
      "comment" : "Alert message before deleting the ticked items from a checklist, shown after the Delete Checked Items menu entry. The placeholder is how many items will be deleted, always at least one. The alert's buttons are Cancel and Delete.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حذف %lld عناصر محددة؟ لا يمكن التراجع عن هذا الإجراء."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حذف %lld عنصرًا محددًا؟ لا يمكن التراجع عن هذا الإجراء."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حذف %lld عنصر محدد؟ لا يمكن التراجع عن هذا الإجراء."
                }
              },
              "other" : {
