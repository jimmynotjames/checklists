    "settings.analytics.toggle.hint" : {
      "comment" : "VoiceOver hint for the analytics opt-in toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح للتطبيق بإرسال بيانات استخدام مجهولة لمساعدة التطبيق على التحسّن. لا يتم تضمين أسماء عناصر قائمة التحقق أو ملاحظات العناصر أو معرّفات Apple أو iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপকে বেনামি ব্যবহারের ডেটা পাঠাতে দেয় অ্যাপ উন্নত করতে। কখনও অন্তর্ভুক্ত নয়: চেকলিস্ট আইটেম নাম, আইটেম নোট বা Apple বা iCloud সনাক্তকারী।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que l'aplicació enviï dades d'ús anònimes per ajudar a millorar l'aplicació. Les dades mai inclouen noms d'elements de la llista, notes d'elements, o identificadors d'Apple o iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní aplikaci odesílat anonymní data o používání, která pomáhají aplikaci zlepšovat. Jména položek kontrolního seznamu, poznámky k položkám ani identifikátory Apple či iCloud nejsou nikdy zahrnuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillader appen at sende anonyme brugsdata for at hjælpe med at forbedre appen. Navn på tjekliste-elementer, element-noter eller Apple- eller iCloud-identifikatorer medtages aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht der App, anonyme Nutzungsdaten zu senden, um die App zu verbessern. Checklisten-Eintrags-Namen, Notizen oder Apple- oder iCloud-Kennungen sind niemals enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στην εφαρμογή να στέλνει ανώνυμα δεδομένα χρήσης για βελτίωση της εφαρμογής. Δεν περιλαμβάνονται ποτέ ονόματα στοιχείων λίστας ελέγχου, σημειώσεις στοιχείων ή αναγνωριστικά Apple ή iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to send anonymous usage data to help improve the app. No checklist item names, item notes, or Apple or iCloud identifiers are ever included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la app envíe datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la app envíe datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen nombres de elementos de la lista, notas de elementos, ni identificadores de Apple o iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii sovellukselle anonyymien käyttötietojen lähettämisen sovelluksen parantamiseksi. Tarkistuslistan kohdan nimiä, kohdan muistiinpanoja tai Apple- tai iCloud-tunnuksia ei koskaan sisällytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à l'app d'envoyer des données d'utilisation anonymes pour l'améliorer. Les noms des éléments de liste, les notes d'éléments et les identifiants Apple ou iCloud ne sont jamais inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à l'application d'envoyer des données d'utilisation anonymes pour aider à améliorer l'application. Les noms des éléments de la liste de vérification, les notes des éléments ou les identifiants Apple ou iCloud ne sont jamais inclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એપ્લીકેશનને એપ્લીકેશણને સુધારવામાં મદદ કરવા માટે અનામી ઉપયોગ ડેટા મોકલવાની મંજૂરી આપે છે. ચેકલિસ્ટ આઇટમ નામો, આઇટમ નોંધો અથવા Apple અથવા iCloud ઓળખકર્તાઓ ક્યારેય સમાવવામાં આવતી નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לאפליקציה לשלוח נתוני שימוש אנונימיים כדי לעזור לשפר את האפליקציה. שמות של פריטים ברשימת תיוג, הערות או מזהים של Apple או iCloud לא כלולים אף פעם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को बेहतर बनाने के लिए अनाम उपयोग डेटा भेजने की अनुमति देता है। चेकलिस्ट आइटम के नाम, आइटम नोट्स, या Apple या iCloud पहचानकर्ता कभी शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućava aplikaciji slanje anonimnih podataka o upotrebi kako bi se poboljšala aplikacija. Nikad nisu uključeni nazivi stavki kontrolnog popisa, bilješke stavki ili Apple ili iCloud identifikatori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi az alkalmazásnak, hogy anonim használati adatokat küldjön az alkalmazás javítása érdekében. Az ellenőrzőlista elemek nevei, elemjegyzetek vagy Apple- vagy iCloud-azonosítók soha nem szerepelnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkan aplikasi mengirim data penggunaan anonim untuk membantu meningkatkan aplikasi. Nama item daftar periksa, catatan item, atau identifikasi Apple atau iCloud tidak pernah disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette all'app di inviare dati di utilizzo anonimi per aiutare a migliorare l'app. Non vengono mai inclusi i nomi degli elementi, le note o gli identificatori di Apple o iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがアプリを改善するために匿名の使用状況データを送信できるようにします。チェックリスト項目の名前、項目のメモ、Appleまたはicloud識別子は含まれません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅ್ಯಾಪ್ ಸುಧಾರಿಸಲು ಅನಾಮಧೇಯ ಬಳಕೆ ಡೇಟಾ ಕಳುಹಿಸುವುದನ್ನು ಅನುಮತಿಸುತ್ತದೆ. ಚೆಕ್‌ಲಿಸ್ಟ್ ಐಟಂ ಹೆಸರುಗಳು, ಐಟಂ ಟಿಪ್ಪಣಿಗಳು ಅಥವಾ Apple ಅಥವಾ iCloud ಗುರುತಿಸುವಿಕೆಗಳು ಎಂದಿಗೂ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 앱 개선을 위해 익명 사용 데이터를 보내도록 허용합니다. 체크리스트 항목 이름, 항목 메모 또는 Apple이나 iCloud 식별자는 절대 포함되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അപ്ലിക്കേഷൻ മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്ന അജ്ഞാത ഉപയോഗ ഡാറ്റ അയയ്ക്കാൻ അപ്ലിക്കേഷനെ അനുവദിക്കുക. ചെക്ക്‌ലിസ്റ്റ് ഇനങ്ങളുടെ പേരുകൾ, ഇനങ്ങളുടെ കുറിപ്പുകൾ, അല്ലെങ്കിൽ Apple അല്ലെങ്കിൽ iCloud ഐഡന്റിഫയറുകൾ ഒരിക്കലും അടങ്ങിയിരിക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अ्‍ॅपला अनामिक वापर डेटा पाठवू शकतो जे अ्‍ॅप सुधारण्यास मदत करतो। चेकलिस्ट आयटम नावे, आयटम टिपा किंवा Apple किंवा iCloud ओळखकर्ता कधीही समाविष्ट केले जात नाहीत।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan aplikasi menghantar data penggunaan tanpa nama untuk membantu meningkatkan aplikasi. Nama item senarai semak, nota item, atau pengecam Apple atau iCloud tidak pernah disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillater appen å sende anonyme bruksdata for å hjelpe til med å forbedre appen. Sjekkliste-elementnavn, notater eller Apple- eller iCloud-identifikatorer er aldri inkludert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt de app in staat anonieme gebruiksgegevens te verzenden om de app te verbeteren. Checklistnamen, itemnotities of Apple- of iCloud-identifiers worden nooit opgenomen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅ୍ୟାପ୍‍କୁ ଉନ୍ନତ କରିବାରେ ସାହାଯ୍ୟ କରିବାକୁ ଅ୍ୟାପ୍‍ କୁ ଅଜ୍ଞାତନାମା ବ୍ୟବହାର ତଥ୍ୟ ପଠାଇବାକୁ ଦେଇଥାଏ। ଚେକଲିଷ୍ଟ ଆଇଟମ୍ ନାମ, ଆଇଟମ୍ ଟିପ୍ପଣୀ, କିମ୍ବା Apple କିମ୍ବା iCloud ଚିହ୍ନାକାରୀ କଦାଚ ଅନ୍ତର୍ଭୁକ୍ତ ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਵਿੱਚ ਮਦਦ ਲਈ ਐਪ ਨੂੰ ਗੁਮਨਾਮ ਵਰਤੋਂ ਡਾਟਾ ਭੇਜਣ ਦੀ ਆਗਿਆ ਦਿੰਦਾ ਹੈ। ਕਦੇ ਵੀ ਚੈੱਕਲਿਸਟ ਆਈਟਮ ਦੇ ਨਾਂ, ਆਈਟਮ ਨੋਟਸ, ਜਾਂ Apple ਜਾਂ iCloud ਪਛਾਣਕਾਰ ਸ਼ਾਮਿਲ ਨਹੀਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umożliwia aplikacji wysyłanie anonimowych danych o użytkowaniu, aby pomóc ulepszyć aplikację. Nazwy elementów listy kontrolnej, notatki do elementów ani identyfikatory Apple i iCloud nigdy nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o app envie dados de uso anônimos para ajudar a melhorar o app. Nomes de itens do checklist, notas de itens ou identificadores Apple ou iCloud nunca são incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que a aplicação envie dados de utilização anónimos para ajudar a melhorar a aplicação. Os nomes de itens da lista de verificação, as notas dos itens, nem nenhuns identificadores Apple ou iCloud são nunca incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite aplicației să trimită date anonime de utilizare pentru a ajuta la îmbunătățirea aplicației. Numele articolelor din listă, notițele articolelor, sau identificatorii Apple sau iCloud nu sunt niciodată incluși."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет приложению отправлять анонимные данные об использовании для улучшения приложения. Названия пунктов чек-листа, заметки пунктов и идентификаторы Apple или iCloud никогда не включаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní aplikácii odoslať anonymné údaje o používaní na jej zlepšenie. Nikdy sa nezbierajú: názvy položiek kontrolného zoznamu, poznámky k položkám alebo identifikátory Apple a iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči aplikaciji, da pošlje anonimne podatke o uporabi za izboljšanje aplikacije. Imena postavk kontrolnega seznama, opombe postavk ali Apple ali iCloud identifikatorji se nikoli ne vključijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåter appen att skicka anonym användningsdata för att förbättra appen. Checklistors namn, objektanteckningar eller Apple- eller iCloud-identifierare lagras aldrig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயன்பாட்டை மேம்படுத்த உதவ பயன்பாட்டை அநாமதேய பயன்பாட்டுத் தரவை அனுப்ப அனுமதிக்கிறது. சரிபார்ப்புப் பட்டியல் உருப்படி பெயர்கள், உருப்படி குறிப்புகள், அல்லது Apple அல்லது iCloud அடையாளங்கள் ஒருபோதும் சேர்க்கப்படுவதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అనువర్తనాన్ని మెరుగుపరచడానికి సహాయపడటానికి అనువర్తనం అనామక వినియోగ డేటాను పంపించడానికి అనుమతిస్తుంది. చెక్‌లిస్ట్ అంశం పేర్లు, అంశం గమనికలు, లేదా Apple లేదా iCloud గుర్తింపులు ఎప్పుడూ చేర్చబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้แอปส่งข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุงแอป ไม่มีการรวมชื่อรายการเช็คลิสต์ หมายเหตุรายการ หรือตัวระบุ Apple หรือ iCloud ใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın uygulamayı iyileştirmeye yardımcı olmak için anonim kullanım verileri göndermesine izin verir. Kontrol listesi öğe adları, öğe notları veya Apple ya da iCloud tanımlayıcıları hiçbir zaman dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє додатку надсилати анонімні дані про використання для вдосконалення додатка. Назви пунктів чек-листу, нотатки до пунктів та ідентифікатори Apple та iCloud ніколи не включаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو گمنام استعمال کا ڈیٹا بھیجنے کی اجازت دیتا ہے تاکہ ایپ کو بہتر بنایا جا سکے۔ چیک لسٹ آئٹم کے نام، آئٹم نوٹس، یا Apple یا iCloud شناخت کبھی شامل نہیں ہوتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép ứng dụng gửi dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Tên mục danh sách kiểm tra, ghi chú mục, hoặc mã định danh Apple hay iCloud không bao giờ được bao gồm."
          }
