# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
#
# Ported from the `simple-recurring-budgets` repo. Deviations from that config are
# called out inline — this project is Swift 6 / iOS 26 and hybrid SwiftUI + UIKit,
# not pure SwiftUI.
#
# Pre-commit and the gate lint changed/staged files only — AGENTS.md §"Lint policy".
--swiftversion 6.0
--indent 2
--importgrouping alpha
--wraparguments before-first
--wrapparameters before-first
# `simple-recurring-budgets` uses `--header strip`. Every file here carries a
# `//  Created by Jimmy Ho ... Copyright © 2020` block that `strip` would delete on
# first format — a large, pointless, authorship-destroying diff. Leave headers alone.
--header ignore
--linebreaks lf
--maxwidth 200
# SwiftLint owns modifier ordering (modifier_order rule). Disabling here prevents the
# swiftformat→swiftlint conflict on modifier reordering.
--disable modifierOrder
# SwiftLint owns brace placement (opening_brace rule, K&R same-line style). SwiftFormat's
# wrapMultilineStatementBraces wants the opposite (brace on its own line) for multiline
# statements, so the two oscillate and swiftlint-fix (run last in pre-commit) wins — leaving
# code that `swiftformat --lint` then rejects. Disable here so swiftformat defers.
--disable wrapMultilineStatementBraces
# build/ and DerivedData/ are gitignored scratch.
--exclude build,DerivedData,.build
