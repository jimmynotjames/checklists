# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
# Compiler version (Xcode 27.2 ships Swift 6.4) and language mode are separate settings; the
# language mode defaults to 5 unless set.
--swift-version 6.4
--language-mode 6
# Also guards hook and manual runs, which skip the gate's exact check against config/lint-tools.env.
--min-version 0.64.1
--unknown-options error
# Test names are IDs that make focused-tests, failure lists and docs refer to; renaming them to
# raw identifiers is its own change.
--test-case-name-format preserve
--indent 2
--importgrouping alpha
--wraparguments before-first
--wrapparameters before-first
# Every file carries a `//  Created by Jimmy Ho ... Copyright © 2020` block that
# `--header strip` would delete on first format — a large, authorship-destroying diff.
--header ignore
--linebreaks lf
--maxwidth 200
# SwiftLint owns modifier ordering (modifier_order rule). Disabling here prevents the
# swiftformat→swiftlint conflict on modifier reordering.
--disable modifierOrder
# SwiftLint owns brace placement (opening_brace rule, K&R same-line style). SwiftFormat's
# wrapMultilineStatementBraces wants the opposite (brace on its own line) for multiline
# statements, so the two oscillate and swiftlint-fix (run last in pre-commit) wins — leaving
# code that `swiftformat --lint` then rejects. Disable here so swiftformat defers.
--disable wrapMultilineStatementBraces
# build/, tmp/ and .claude/ (agent worktrees) are scratch (.build and DerivedData are excluded by default).
--exclude build,tmp,.claude
