{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/guard_bash_hygiene.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Skill",
      "Agent",
      "Read(./**)",
      "Edit(./**)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Bash(bash -n scripts/*)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(gitleaks *)",
      "Bash(lefthook *)",
      "Bash(fastlane *)",
      "Bash(openspec *)",
      "Bash(mkdir *)",
      "Bash(lipo *)",
      "Bash(UI_WORKERS=* *)",
      "Bash(UI_RETRY_ON_FAILURE=* *)",
      "Bash(TEST_RUNNER_FORCE_ANIMATIONS=* *)",
      "Bash(SIMULATOR_SLOTS_FEWER=* *)",
      "Bash(SIMULATOR_SLOTS_TIMEOUT=* *)",
      "Bash(SIMULATOR_SLOTS_MASTER=* *)",
      "Bash(rm -f tmp/*)",
      "Bash(rm -rf tmp/*)",
      "mcp__18cf5017-f11b-4601-92d4-9f346ebf3d65"
    ]
  }
}
