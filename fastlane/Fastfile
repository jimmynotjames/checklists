default_platform(:ios)
skip_docs
opt_out_usage

platform :ios do
  before_all do
    %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_FILEPATH].each do |name|
      UI.user_error!("Set #{name} in fastlane/.env; see fastlane/SETUP.md") if ENV[name].to_s.strip.empty?
    end
    key_path = File.expand_path(ENV.fetch("ASC_API_KEY_FILEPATH"))
    UI.user_error!("ASC API key file is missing or unreadable") unless File.file?(key_path) && File.readable?(key_path)
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )
  end

  desc "Verify read-only access to the existing checklists app"
  lane :verify_auth do
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No access to #{identifier}") unless app && app.bundle_id == identifier
    UI.success("Auth OK: #{app.name} (#{app.bundle_id}, ASC #{app.id})")
  end
end
