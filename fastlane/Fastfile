default_platform(:ios)
skip_docs
opt_out_usage
require_relative "lib/release_build"
require_relative "lib/metadata_publish"
require_relative "lib/screenshot_publish"
require_relative "lib/screenshot_capture"

RELEASE_ROOT = File.expand_path("..", __dir__)

platform :ios do
  before_all do |lane|
    next if lane == :screenshots
    %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_FILEPATH].each do |name|
      UI.user_error!("Set #{name} in fastlane/.env; see fastlane/SETUP.md") if ENV[name].to_s.strip.empty?
    end
    key_path = File.expand_path(ENV.fetch("ASC_API_KEY_FILEPATH"))
    UI.user_error!("ASC API key file is missing or unreadable") unless File.file?(key_path) && File.readable?(key_path)
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )
  end

  desc "Verify read-only access to the existing checklists app"
  lane :verify_auth do
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No access to #{identifier}") unless app && app.bundle_id == identifier
    UI.success("Auth OK: #{app.name} (#{app.bundle_id}, ASC #{app.id})")
    version = ReleaseBuild.new(RELEASE_ROOT).version
    latest = latest_testflight_build_number(app_identifier: identifier, version: version, initial_build_number: 0, platform: "ios")
    UI.message("Latest TestFlight build for #{version}: #{latest}")
  end

  desc "Validate and upload metadata to an existing editable version; no binary or screenshots"
  lane :push_metadata do |options|
    requested = options[:app_version].to_s
    UI.user_error!("Pass app_version:<version> explicitly") if requested.strip.empty?
    # Blocking: every storefront must be transcreated and within Apple's limits before
    # anything is uploaded. Run the appstore-translate-metadata skill if this fails.
    sh("python3", File.join(RELEASE_ROOT, "scripts/translate_metadata/check_metadata.py"))
    # Advisory: flags exclamation marks, shouting, and superlatives in the en-US source,
    # which would otherwise propagate to all 49 storefronts.
    begin
      sh("python3", File.join(RELEASE_ROOT, "scripts/translate_metadata/check_source_voice.py"))
    rescue StandardError
      UI.important("Source-voice check raised findings in the en-US copy — see above. Continuing.")
    end
    sh("python3", File.join(RELEASE_ROOT, "scripts/appstore_metadata.py"), "prepare", "--output", File.join(RELEASE_ROOT, "tmp/appstore-metadata"))
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No access to #{identifier}") unless app && app.bundle_id == identifier
    version = app.get_edit_app_store_version(platform: "IOS")
    MetadataPublish.validate_target!(version, requested)
    upload_to_app_store(MetadataPublish.options(identifier, requested, File.join(RELEASE_ROOT, "tmp/appstore-metadata")))
  end

  desc "Read the primary language and existing editable-version screenshot sets"
  lane :inspect_screenshots do
    require "json"
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No access to #{identifier}") unless app && app.bundle_id == identifier
    UI.message(JSON.pretty_generate(ScreenshotPublish.inventory(app)))
  end

  desc "Capture and validate the configured marketing screenshots locally"
  lane :screenshots do |options|
    result = ScreenshotCapture.new(RELEASE_ROOT).capture(options) do |snapshot_options|
      capture_screenshots(snapshot_options)
    end
    UI.success("Screenshot run #{result.fetch('run_id')}: #{result.fetch('screenshots_path')}")
  end

  desc "Publish a reviewed screenshot run to an explicit existing editable version"
  lane :push_screenshots do |options|
    require "json"
    require "open3"
    require "deliver"
    version = options[:app_version].to_s
    run_id = options[:run_id].to_s
    UI.user_error!("Pass app_version:<version> and run_id:<reviewed-run> explicitly") if version.empty? || run_id.empty?
    # --upload stages into its own folder, so a subset never replaces the run's reviewed set.
    command = ["python3", File.join(RELEASE_ROOT, "scripts/screenshot_content/prepare_output.py"),
               "--run-id", run_id, "--upload"]
    command += ["--locales", options[:locales].to_s] if options[:locales]
    output, status = Open3.capture2e(*command)
    UI.user_error!(output) unless status.success?
    staging = JSON.parse(output)
    report = JSON.parse(File.read(staging.fetch("report")))
    locales = report.fetch("files").map { |file| file.fetch("storefront") }.uniq
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No access to #{identifier}") unless app && app.bundle_id == identifier
    begin
      deliver_error = ScreenshotPublish.publish(
        app: app, version: version, locales: locales,
        screenshots: Deliver::Loader.load_app_screenshots(staging.fetch("output"), false),
        uploader: Deliver::UploadScreenshots.new
      )
    rescue ScreenshotPublish::IncompletePublish => e
      rows = JSON.parse(File.read(File.join(RELEASE_ROOT, "fastlane", "screenshot-config.json"))).fetch("locales")
      runtime = e.failures.keys.map { |storefront| rows.find { |row| row.fetch("storefront") == storefront }.fetch("runtime") }
      passed = locales - e.failures.keys
      UI.user_error!("#{e.message}\nVerified: #{passed.length} locale(s). Inspect, then retry only the rest:\n" \
                     "fastlane ios push_screenshots app_version:#{version} run_id:#{run_id} locales:#{runtime.join(',')}")
    end
    UI.important("Deliver stopped (#{deliver_error.message}); every locale verified anyway.") if deliver_error
    UI.success("Screenshots uploaded for #{version}: #{locales.join(', ')}; run #{run_id}")
  end

  desc "Archive and export locally with existing signing assets; never upload or commit"
  lane :archive_validation do
    ReleaseBuild.new(RELEASE_ROOT).archive_only do |options|
      build_app(options)
    end
  end

  desc "Archive, upload to TestFlight, then commit only the app build number"
  lane :beta do
    record = ReleaseBuild.new(RELEASE_ROOT).beta(
      latest: lambda { |version|
        latest_testflight_build_number(
          app_identifier: ReleaseBuild::IDENTIFIER,
          version: version, initial_build_number: 0, platform: "ios"
        )
      },
      archive: lambda { |options| build_app(options) },
      upload: lambda { |ipa|
        upload_to_testflight(ipa: ipa, skip_waiting_for_build_processing: true)
      }
    )
    UI.success("Uploaded and committed the build number. Recovery record: #{record}")
  end
end
