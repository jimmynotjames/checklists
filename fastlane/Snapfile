# Screenshot defaults. The screenshots lane supplies a run-scoped output/cache and,
# per target, the one capture simulator's exact name (AGENTS.md §"Simulator sandbox").
# No `devices` default: snapshot rejects names that do not exist yet, and each
# device's capture simulator is created just before its turn.
require "json"

unless ENV["CHECKLISTS_SCOPED_SCREENSHOT_CAPTURE"] == "1"
  raise "Use `fastlane ios screenshots`; direct snapshot bypasses per-checkout simulator isolation"
end

root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
config = JSON.parse(File.read(File.join(root, "fastlane", "screenshot-config.json")))
languages(config.fetch("active_locales"))
scheme("checklists")
only_testing(["checklistsUITests/AppStoreScreenshots"])
output_directory("./.build/screenshots/direct")
clear_previous_screenshots(false)
erase_simulator(false)
reinstall_app(false)
override_status_bar(true)
localize_simulator(false)
concurrent_simulators(false)
stop_after_first_error(true)
skip_open_summary(true)
