// config/Secrets.xcconfig — committed. Safe placeholder defaults only.
//
// Real tokens live in config/Secrets.local.xcconfig, which is gitignored and included
// at the bottom of this file. A fresh clone has no local file, resolves to the
// PLACEHOLDER_* sentinels below, and still builds and launches — analytics simply fall
// back to the console client (see MixpanelTokenSource.isConfigured).
//
// These sentinel strings MUST stay in sync with three places:
//   1. AppConfig.Placeholder                  (checklists/checklists/App/AppConfig.swift)
//   2. scripts/verify_release_secrets.sh      (the ship guard, which reads this file directly)
//   3. AppConfigSentinelTests                 (which asserts 1 and 2 agree)
//
// Note: xcconfig treats "//" as a comment, so any future URL-valued key needs the
// SLASH/DOUBLE_SLASH indirection trick that budgets1 uses. There are no URL keys here yet.

MIXPANEL_DEV_TOKEN = PLACEHOLDER_MIXPANEL_DEV_TOKEN
MIXPANEL_PROD_TOKEN = PLACEHOLDER_MIXPANEL_PROD_TOKEN

// Optional local overrides (gitignored). Included LAST so its values win.
#include? "Secrets.local.xcconfig"
