// config/Secrets.local.xcconfig.template — committed reference copy.
//
// Copy this to config/Secrets.local.xcconfig (gitignored) and paste the real project
// tokens from Mixpanel → Settings → Project Settings → Project Token.
// See core-docs/secrets-list.md for the complete fresh-clone secret inventory.
//
//     cp config/Secrets.local.xcconfig.template config/Secrets.local.xcconfig
//
// The dev token routes Debug builds to "reChecklist App - Dev"; the prod token routes
// Release builds to "reChecklist App - Prod". See core-docs/analytics-spec.md §10.

MIXPANEL_DEV_TOKEN = your_32_char_dev_token_here
MIXPANEL_PROD_TOKEN = your_32_char_prod_token_here
